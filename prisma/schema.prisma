// Schéma "tenant" — pas de multiSchema, queries Prisma émises non-qualifiées
// (`SELECT * FROM "User"`) pour permettre le routing par `search_path` en
// Phase 3 (schema-per-tenant `client_<slug>`).
//
// Ce fichier est une COPIE des modèles tenant de prisma/schema.prisma sans
// les annotations @@schema. Il ne sert QU'à la codegen du client tenant
// (utilisé par défaut dans lib/prisma.ts → `import { prisma }`).
//
// Source de vérité pour les migrations DB : prisma/schema.prisma. Quand
// un modèle tenant change, mettre à jour les DEUX fichiers en parallèle.
// Les modèles admin (Client, Subscription, AuditLog) ne sont PAS dans ce
// fichier — ils restent dans prisma/schema.prisma + multiSchema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                      @id @default(cuid())
  email                    String                      @unique
  /// Nullable depuis le chantier SSO : un compte fédéré (ssoProvider non null)
  /// n'a pas de mot de passe Physalis. Credentials refuse si password est null.
  password                 String?
  /// SSO — null pour un compte mot de passe classique ; "google"|"github"|…
  /// pour un compte fédéré (dénormalisé pour l'affichage UI sécurité).
  ssoProvider              String?
  role                     Role                        @default(MEMBER)
  /// 2FA TOTP — secret chiffré avec la même ENCRYPTION_KEY que les Secrets
  /// (3 colonnes : encryptedValue/iv/tag, base64). Désactivé par défaut.
  twoFactorEnabled         Boolean                     @default(false)
  twoFactorSecret          String?
  twoFactorIv              String?
  twoFactorTag             String?
  /// 8 codes de secours bcrypt-hashés. Vidé à chaque rotation 2FA.
  backupCodes              String[]                    @default([])
  /// §2.17 — dernier pas de temps TOTP consommé (RFC 6238 §5.2, anti-rejeu).
  /// Un code n'est accepté que si son timeStep > lastTotpTimeStep.
  lastTotpTimeStep         Int?
  projects                 ProjectMember[]
  organizations            OrgMember[]
  invitationsSent          Invitation[]                @relation("invitedBy")
  invitationsReceived      Invitation[]                @relation("invitationsReceived")
  createdMachineTokens     MachineToken[]              @relation("machineTokenCreator")
  pluginTokens             PluginToken[]
  cliSessions              CliSession[]
  cliDeviceAuths           CliDeviceAuthorization[]
  vaultEntries             VaultEntry[]
  vaultCollections         VaultCollection[]
  teamVaultMemberships     TeamVaultMember[]
  userTokens               UserToken[]
  orgTokensCreated         OrgToken[]                  @relation("orgTokenCreator")
  oneTimeShares            OneTimeShare[]              @relation("oneTimeShareCreator")
  accessLogs               AccessLog[]                 @relation("accessLogActor")
  secretRequests           SecretRequest[]             @relation("secretRequestCreator")
  secretVersions           SecretVersion[]             @relation("secretVersionCreator")
  orgSecretVersions        OrgSecretVersion[]          @relation("orgSecretVersionCreator")
  mobileCredentialVersions MobileCredentialVersion[]   @relation("mobileCredentialVersionCreator")
  apiKeysCreated           ApiKey[]                    @relation("apiKeyCreator")
  notificationReads        NotificationRead[]
  createdAt                DateTime                    @default(now())
  /// #5 — borne basse de validité des sessions : tout JWT émis avant cette
  /// date est rejeté par requireUser(). Posé au reset password / 2FA disable
  /// pour couper les sessions existantes. NULL = jamais invalidé (legacy).
  sessionsValidFrom        DateTime?
  /// Nouveautés (C-0048, T-0267) : dernière fois que la personne a VU la
  /// section Nouveautés. Les annonces publiées après sont comptées dans la
  /// pastille verte. NULL = jamais → repli sur `createdAt` (un nouvel inscrit
  /// ne reçoit pas tout l'historique d'un coup).
  announcementsSeenAt      DateTime?
  /// Suppression de compte MEMBRE (self-service) — à ne pas confondre avec la
  /// suppression du compte CLIENT, qui vit sur `admin.clients`. Ici le tenant
  /// survit : seule cette ligne `User` et ses dépendances en Cascade (coffre
  /// perso, appartenances, tokens) disparaissent à `purgeAt`. C'est
  /// `deletionRequestedAt` — et non un statut — qui fait foi et déclenche le
  /// verrou d'espace. NULL hors processus.
  deletionRequestedAt      DateTime?
  purgeAt                  DateTime?
  /// Dernier export RGPD réussi (/api/me/export). Alimente le compteur
  /// « X membres sur Y ont récupéré leurs données » et la règle du plancher
  /// côté owner ; seul un export POSTÉRIEUR à la demande compte.
  dataExportedAt           DateTime?
  /// Identités externes liées (social login / SSO perso, Phase F).
  socialIdentities         UserSocialIdentity[]
  /// Les autorisations OAuth d'automatisation que cette personne a accordées
  /// ([T-0260]). ⚠️ `SetNull` côté credential : son départ ne doit pas effacer
  /// l'autorisation qui fait tourner la production, il doit se VOIR.
  automationOAuthConsents  AutomationOAuthCredential[] @relation("automationOAuthConsent")
}

/// Identité externe (social login / SSO perso) liée à un User. L'utilisateur lie
/// explicitement son compte Google/GitHub/Microsoft depuis /account/security
/// (via l'app OAuth de Physalis, pas celle du tenant) ; au login social on
/// retrouve le User par (provider, sub). PAS d'auto-provisioning. Voir
/// steps-docs/todo/sso.md (Phase F).
model UserSocialIdentity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Provider social : "google" | "github" | "microsoft".
  provider  String
  /// Subject id stable de l'IdP — clé de matching au login.
  sub       String
  /// Email au moment du lien (affichage/audit ; PAS la clé de match). Nullable :
  /// certains IdP (GitHub email masqué) ne le renvoient pas.
  email     String?
  createdAt DateTime @default(now())

  @@unique([provider, sub])
  @@unique([userId, provider])
  @@index([userId])
}

/// Session CLI (`sv_cli_…`) — chantier C-0050, phase 2. Obtenue par flux
/// d'appareil (`physalis login`) : liée à un utilisateur et à un appareil,
/// 12 h, révocable depuis le compte. Hash SHA-256 seul, jamais le brut.
/// `kind` en TEXTE (HUMAN | AI) : un enum tenant-only casse le deploy admin.
/// `scope` : réservé à la session IA (projets/environnements autorisés).
model CliSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String    @default("HUMAN")
  scope      Json?
  deviceName String?
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// Demande de connexion CLI en attente (flux d'appareil, sur le modèle de
/// RFC 8628). La CLI garde le code appareil (haché ici), l'utilisateur voit le
/// code court et l'approuve depuis le navigateur. La session n'est créée qu'au
/// poll suivant l'approbation (status APPROVED → CONSUMED), pour que le jeton
/// ne soit rendu qu'une fois. `status` en TEXTE : PENDING | APPROVED | DENIED
/// | CONSUMED.
model CliDeviceAuthorization {
  id             String    @id @default(cuid())
  deviceCodeHash String    @unique
  userCode       String    @unique
  kind           String    @default("HUMAN")
  scope          Json?
  deviceName     String?
  userAgent      String?
  ip             String?
  status         String    @default("PENDING")
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interval       Int       @default(5)
  lastPolledAt   DateTime?
  decidedAt      DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

model PluginToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  members                    OrgMember[]
  projects                   Project[]
  projectGroups              ProjectGroup[]
  invitations                Invitation[]
  secrets                    OrgSecret[]
  servers                    Server[]
  ciConnections              CiConnection[]
  n8nConnections             N8nConnection[]
  automationOAuthCredentials AutomationOAuthCredential[]
  teamVaultCollections       TeamVaultCollection[]
  oneTimeShares              OneTimeShare[]
  accessLogs                 AccessLog[]
  secretRequests             SecretRequest[]
  orgTokens                  OrgToken[]
  notifications              Notification[]
  notificationDestinations   NotificationDestination[]
  rotationFeatureEnabled     Boolean                     @default(false)
  /// Préavis d'échéance de rotation (C-0048, T-0262), en jours. 0 = désactivé.
  /// Vise les entrées / secrets dont la rotation est MANUELLE (rappel).
  rotationPreavisDays        Int                         @default(7)
  /// Rappel d'ancienneté (T-0262) : entrée ou secret inchangé depuis N jours,
  /// rotation réglée ou non. NULL = désactivé (défaut — opt-in de l'org, pour
  /// ne pas déverser une notification par vieille entrée au déploiement).
  rotationAncienneteDays     Int?
  // ─── Cloisonnement orgs (refonte pricing) ──────────────────────────
  /// org principale = compte général du tenant. Ses quotas sont DÉRIVÉS
  /// du plan (PLAN_QUOTAS + client.extra*) ; les champs maxX ci-dessous
  /// sont ignorés pour la primaire. Les orgs ajoutées portent leur
  /// propre bundle isolé (ADDON_ORG_BUNDLE).
  isPrimary                  Boolean                     @default(false)
  /// Quotas isolés des orgs AJOUTÉES (defaults = ADDON_ORG_BUNDLE).
  maxServers                 Int                         @default(2)
  maxOidcProjects            Int                         @default(10)
  /// Posé pour le futur — emails restent métrés au niveau client (non
  /// branché par org en Phase B).
  maxEmailsPerMonth          Int                         @default(1000)
  extraEmails                Int                         @default(0)
  /// Sièges propres à l'org (confinés, isolés du pool global du plan).
  maxSeats                   Int                         @default(2)
  createdAt                  DateTime                    @default(now())
}

/// Configuration email Physalis Email au niveau CLIENT (tenant) — singleton par
/// schéma tenant. Le compte Physalis Email est créé avec `externalRef = tenantSlug`
/// (globalement unique, contrairement au slug d'org qui ne l'est qu'au sein du
/// tenant). `accountId` = compte partagé par TOUS les projets/orgs du client.
/// `enabled` : interrupteur explicite. `tenantSlug` sert de clé d'upsert.
model ClientEmailConfig {
  id         String   @id @default(cuid())
  tenantSlug String   @unique
  enabled    Boolean  @default(false)
  accountId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Interrupteur du service de backup automatisé au niveau CLIENT (tenant) —
/// singleton par schéma tenant, comme ClientEmailConfig. `enabled` = master
/// switch ; la config par projet (ProjectBackupConfig, cf. spec backups-auto.md)
/// viendra ensuite et exigera ce switch.
model ClientBackupConfig {
  id             String   @id @default(cuid())
  tenantSlug     String   @unique
  enabled        Boolean  @default(false)
  /// Destination des backups, au niveau CLIENT (un VPS pour tous ses projets).
  /// Le chemin effectif d'un projet est dérivé : backupPath/<slug projet>.
  backupServerId String?
  backupServer   Server?  @relation("BackupDest", fields: [backupServerId], references: [id])
  backupPath     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Config de backup automatisé d'un projet (cf. documentation/plans/done/backups-auto.md).
/// Physalis ne détient QUE la clé GPG publique (postée par l'agent) ; ni le mot
/// de passe DB ni la clé privée ne vivent ici. La destination est un Server.
model ProjectBackupConfig {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  enabled         Boolean @default(false)
  /// Un seul environnement backupé par projet (prod par défaut).
  environmentName String

  // DB(s) source : multi-DB → modèle enfant ProjectBackupDatabase.
  // La destination vit au niveau CLIENT (ClientBackupConfig).

  // GPG : Physalis ne tient que le public (posté par l'agent à l'enregistrement)
  gpgPublicKey      String?
  gpgKeyId          String?
  agentRegisteredAt DateTime?

  // Chiffrement par enveloppe + KMS (système ①, cf. backup-clients-kms-plan.md).
  // Dual-path : null/"gpg-rsa4096" = legacy GPG par-VPS ; "kms-envelope-v1" =
  // l'agent scelle via OpenBao transit (datakey) → archive .penv.
  // `kmsKeyName` = nom logique de la KEK transit du tenant (`tenant-<slug>`).
  // Physalis ne détient JAMAIS la KEK ni de capacité decrypt sur les données.
  backupKeyScheme  String?
  kmsKeyName       String?
  /// Hash SHA-256 du token d'agent — vérifie register/plan/report (timingSafeEqual,
  /// sans déchiffrer à chaque poll).
  agentTokenHash   String?
  /// Copie chiffrée (AES-256-GCM) du MÊME token, pour l'injection zéro-touch dans le
  /// bundle de déploiement (Physalis déchiffre et pose BACKUP_TOKEN). Même posture que
  /// la clé SSH du serveur, déjà dans le bundle. Null tant qu'aucun token n'a été émis.
  agentTokenEnc    String?
  agentTokenIv     String?
  agentTokenTag    String?
  /// Anti-spam du watchdog : dernière alerte « backup en retard » envoyée.
  overdueAlertedAt DateTime?

  // Rétention (appliquée côté agent)
  retentionDaily   Int @default(7)
  retentionWeekly  Int @default(4)
  retentionMonthly Int @default(3)

  // Planification (servie à l'agent ; le cron Physalis = watchdog)
  scheduleHour     Int       @default(3)
  intervalDays     Int       @default(1)
  backupNextAt     DateTime?
  backupLastAt     DateTime?
  backupLastStatus String?
  backupErrorCount Int       @default(0)
  forceRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  databases ProjectBackupDatabase[]
  entries   ProjectBackupEntry[]
  restores  ProjectBackupRestore[]
}

/// Une DB d'un projet à sauvegarder (un projet peut en avoir plusieurs).
/// Détectée depuis le docker-compose + .env, éditable par l'utilisateur.
/// Physalis ne stocke PAS le mot de passe : seulement la clé du secret (.env)
/// qui le contient, pour l'injecter au déploiement.
model ProjectBackupDatabase {
  id       String              @id @default(cuid())
  configId String
  config   ProjectBackupConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  dbType            BackupDbType
  dbName            String
  /// Hostname sur le réseau docker du projet (= nom du service db).
  dbHost            String
  dbUser            String
  /// Clé du secret (.env) contenant le mot de passe (null si en clair / non résolu).
  passwordSecretKey String?
  port              Int?
  enabled           Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([configId])
}

/// Une archive de backup (remplie par les rapports de l'agent — tranche suivante).
model ProjectBackupEntry {
  id        String              @id @default(cuid())
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configId  String
  config    ProjectBackupConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  filename        String
  sizeBytes       BigInt?
  dbType          BackupDbType
  dbName          String
  environmentName String
  destLocation    String

  status       BackupEntryStatus
  errorMessage String?
  restorable   Boolean           @default(true)
  restoreJobId String?
  createdAt    DateTime          @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status])
  @@index([configId])
}

/// Job de restauration orchestré (agent-driven, système ①, cf. backup-clients-kms-plan.md §4).
/// Le control plane crée la demande (PENDING) ; l'agent la poll, tire l'archive
/// `.penv` depuis la destination, déchiffre via OpenBao (identité restore = decrypt),
/// et restaure EN LOCAL sur le VPS. Physalis ne voit jamais le plaintext.
model ProjectBackupRestore {
  id        String              @id @default(cuid())
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configId  String
  config    ProjectBackupConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  filename        String
  destLocation    String
  dbType          BackupDbType
  dbName          String // DB source (= clé pour matcher la connexion côté agent)
  environmentName String
  targetDbName    String // DB cible (par défaut = dbName ; distincte pour une restauration sûre)
  /// true = remplacer en place (la cible peut être non vide ; le dump --clean
  /// drop+recreate). false = restaurer dans une DB neuve/vide (garde-fou agent).
  replaceExisting Boolean      @default(false)

  status        RestoreStatus @default(PENDING)
  errorMessage  String?
  requestedById String?
  claimedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([configId, status])
  @@index([projectId, createdAt(sort: Desc)])
}

enum RestoreStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum BackupDbType {
  POSTGRESQL
  MYSQL
  MARIADB
}

enum BackupEntryStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Configuration email Physalis Email au niveau projet : un domaine + une clé API
/// par projet, partagés par tous ses environnements (injectés dans le .env au
/// déploiement). La clé API est chiffrée au repos (même schéma AES-256-GCM que
/// Secret/Service). Les enregistrements DNS sont mémorisés en JSON.
model ProjectEmailConfig {
  id                   String    @id @default(cuid())
  projectId            String    @unique
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain               String
  domainId             String
  keyId                String
  encryptedKey         String
  iv                   String
  tag                  String
  verified             Boolean   @default(false)
  dnsRecords           Json      @default("[]")
  /// Expéditeur principal du projet, injecté en `PHYSALIS_EMAIL_FROM` au
  /// déploiement. On ne stocke que l'ADRESSE : le nom d'affichage vit côté
  /// relais (sur le sender) et y est appliqué à l'envoi, donc le renommer ne
  /// demande pas de redeploy. Le premier expéditeur créé le devient d'office ;
  /// supprimer l'expéditeur principal remet ce champ à null.
  defaultSender        String?
  /// Rotation automatique de la clé API (blue/green). À la rotation, on crée
  /// une nouvelle clé + redeploy, et on diffère la révocation de l'ancienne au
  /// cycle suivant (fenêtre de grâce — l'app lit la clé depuis son .env, mis à
  /// jour seulement au redeploy). `pendingRevokeKeyId` = ancienne clé à révoquer.
  rotationEnabled      Boolean   @default(false)
  rotationIntervalDays Int?
  rotationNextAt       DateTime?
  rotationLastAt       DateTime?
  rotationLastStatus   String?
  rotationErrorCount   Int       @default(0)
  pendingRevokeKeyId   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([rotationNextAt])
}

model Server {
  id             String               @id @default(cuid())
  name           String
  ip             String
  sshUser        String
  encryptedKey   String
  iv             String
  tag            String
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments   Environment[]
  backupDests    ClientBackupConfig[] @relation("BackupDest")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

enum DatabaseType {
  POSTGRESQL
  MYSQL
  MONGODB
}

model OrgSecret {
  id             String             @id @default(cuid())
  key            String
  encryptedValue String
  iv             String
  tag            String
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       OrgSecretVersion[]
  /// Rappel manuel de renouvellement (ex. expiration d'un PAT). Saisi à la création
  /// via une durée ; Physalis ne connaît pas l'expiration réelle d'un token GitHub.
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, key])
}

/// Historique des valeurs d'un OrgSecret (Phase 10 — versioning).
/// Cf. SecretVersion pour la spec complète. Mêmes contraintes :
/// rétention 50 versions, UNIQUE(orgSecretId, version) pour les races.
model OrgSecretVersion {
  id             String    @id @default(cuid())
  orgSecretId    String
  orgSecret      OrgSecret @relation(fields: [orgSecretId], references: [id], onDelete: Cascade)
  encryptedValue String
  iv             String
  tag            String
  version        Int
  createdById    String?
  createdBy      User?     @relation("orgSecretVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@unique([orgSecretId, version])
  @@index([orgSecretId, version(sort: Desc)])
}

model OrgMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole      @default(MEMBER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model Invitation {
  id             String    @id @default(cuid())
  email          String
  organizationId String
  role           OrgRole   @default(MEMBER)
  /// #2 — accès projet pré-attribués à l'invitation (appliqués à l'acceptation).
  /// Tableau JSON `[{ projectId, role }]`. Null = aucun accès projet pré-set.
  projectAccess  Json?
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  inviteeUserId  String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("invitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  inviteeUser  User?        @relation("invitationsReceived", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviteeUserId])
}

model Project {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  organizationId             String
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members                    ProjectMember[]
  environments               Environment[]
  automationOAuthCredentials AutomationOAuthCredential[]
  tokens                     MachineToken[]
  accessLogs                 AccessLog[]
  services                   Service[]
  appAccounts                AppAccount[]
  policies                   Policy[]
  teamVaultCollections       TeamVaultCollection[]
  secretRequests             SecretRequest[]
  apis                       Api[]
  emailConfig                ProjectEmailConfig?
  backupConfig               ProjectBackupConfig?
  backupEntries              ProjectBackupEntry[]
  backupRestores             ProjectBackupRestore[]
  docs                       ProjectDoc[]
  mobileApps                 MobileApp[]
  notifications              Notification[]
  notificationDestinations   NotificationDestination[]
  /// Groupe d'organisation (kanban projets). Null = « Sans groupe ».
  groupId                    String?
  group                      ProjectGroup?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Ordre du projet à l'intérieur de son groupe (ou des non-groupés). Posé
  /// explicitement par le drag-and-drop ; ties cassés par createdAt.
  position                   Int                         @default(0)
  githubRepo                 String?
  githubWorkflow             String?
  /// Connexion CI/CD org-level (provider + issuer + tokens). Cf. modèle public.
  ciConnectionId             String?
  ciConnection               CiConnection?               @relation(fields: [ciConnectionId], references: [id], onDelete: SetNull)
  /// Repo natif quand le provider ≠ github (group/project GitLab ou UUID Bitbucket).
  ciRepo                     String?
  /// Dernier fetch des docs depuis le repo (null = jamais tenté). Distingue
  /// « aucun fichier de doc » de « jamais récupéré ».
  docsFetchedAt              DateTime?
  rotationPaused             Boolean                     @default(false)
  /// Onglet « Mobile » activé pour CE projet — DÉFAUT OFF. Deux verrous
  /// distincts : la feature de plan `mobile_deploy` (payante, refusée en FREE)
  /// ouvre la capacité au tenant, ce drapeau la déclenche projet par projet
  /// depuis la modale Paramètres. Un projet sans publication mobile ne porte
  /// donc pas l'onglet.
  mobileEnabled              Boolean                     @default(false)
  /// Premier rapport de déploiement `succeeded` reçu (C-0051). Posé une seule
  /// fois par /api/deploy/report, jamais remis à zéro : c'est le signal qui
  /// ferme l'onglet « Installation ». Ne dépend PAS de l'audit, dont la purge
  /// par rétention ferait réapparaître l'onglet sur un projet en prod.
  setupCompletedAt           DateTime?
  /// Choix explicite de l'utilisateur pour l'onglet « Installation » (C-0051),
  /// réglé dans la modale Paramètres : null = automatique (visible tant que
  /// setupCompletedAt est null), "shown" = toujours, "hidden" = jamais.
  setupGuide                 String?
  /// Projet créé AVANT la mise en service du guide (arbitrage A2). Posé par le
  /// backfill de la migration, retiré par la vérification (lib/project-verify.ts),
  /// jamais remis à true par l'application. Il change le contenu de l'onglet
  /// (message d'entrée + vérification), pas sa visibilité.
  setupLegacy                Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())

  @@index([organizationId])
  @@index([ciConnectionId])
  @@index([groupId])
}

/// Groupe de projets au niveau organisation (regroupement type kanban sur la
/// page Projets). L'ordre des groupes et des projets dedans est piloté par le
/// drag-and-drop. La suppression d'un groupe détache ses projets (SetNull).
model ProjectGroup {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]
  /// Ordre de la section groupe sur la page.
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// Interrupteur du service d'automatisation conversationnelle au niveau CLIENT
/// (tenant) — singleton par schéma, comme ClientEmailConfig et
/// ClientBackupConfig. `enabled` commande l'onglet « Automatisations » du
/// header : un service qu'on n'a pas activé n'encombre pas la navigation.
/// Cf. chantier C-0046, phase A.
model ClientAutomationConfig {
  id              String   @id @default(cuid())
  tenantSlug      String   @unique
  enabled         Boolean  @default(false)
  /// L'entrée du coffre d'ÉQUIPE qui porte la clé du modèle (BYOK, §7).
  ///
  /// ⚠️ **On stocke le POINTEUR, jamais la clé.** Le produit qui vend le
  /// stockage de secrets se sert de son propre stockage : Physalis n'acquiert
  /// aucune copie à protéger, à faire tourner, ni à inscrire au registre de
  /// re-keying.
  ///
  /// ⚠️ Pas de clé étrangère, délibérément — comme `N8nCredentialLink.entryId`.
  /// Une cascade effacerait le pointeur au moment précis où il faut VOIR que
  /// l'entrée a disparu : « aucune clé désignée » et « la clé désignée n'existe
  /// plus » appellent deux messages différents.
  modelKeyEntryId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Instance N8N d'un client, au niveau organisation. Physalis n'héberge PAS
/// N8N : il parle à l'API d'une instance que le client fait tourner lui-même
/// (décision fondatrice du chantier C-0046 — licence, isolation, coût).
///
/// ⚠️ Le secret porté par `N8nConnectionSecret` est une clé API N8N, donc le
/// CONTRÔLE TOTAL de l'instance du client. Même classe de pouvoir que le
/// `redeploy_token` de `CiConnection`, dont ce modèle reprend la forme.
model N8nConnection {
  id                     String                @id @default(cuid())
  organizationId         String
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// L'environnement qui porte cette instance, ou `null` pour une instance de
  /// l'organisation entière (T-0258).
  ///
  /// ⚠️ **L'ENVIRONNEMENT et non le projet**, parce que c'est là que vit la
  /// réalité : `Environment.dockerCompose` est le fichier où un service `n8n`
  /// se détecte, et un projet avec `production` et `staging` peut donc en faire
  /// tourner deux. Une colonne `projectId` aurait forcé à n'en connecter qu'un,
  /// et à choisir lequel sans le dire.
  ///
  /// ⚠️ **Ce champ est une BARRIÈRE D'ACCÈS, pas un rangement.** La clé API
  /// d'une connexion donne le contrôle total de l'instance en face : une
  /// connexion d'environnement ne doit être ni vue ni pilotée par un membre de
  /// l'organisation qui n'est pas membre du PROJET de cet environnement. Le
  /// filtre par `organizationId`, seul, ne suffit donc plus — cf.
  /// `porteeConnexionWhere` (lib/automation/portee.ts), qui passe par
  /// `accessibleProjectsWhere` (lequel porte la règle du `ProjectMember.hidden`).
  ///
  /// `onDelete: Cascade` : un environnement supprimé emporte sa connexion.
  /// Laisser une connexion orpheline la ferait retomber, `environmentId` à
  /// null, dans le périmètre de TOUTE l'organisation — une suppression qui
  /// ÉLARGIT un accès.
  environmentId          String?
  environment            Environment?          @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  name                   String
  oauthPoses             AutomationOAuthPose[]
  /// Sans slash final — la construction des URL d'API le suppose.
  baseUrl                String
  /// "direct" (Physalis appelle l'instance) | "pull" (l'instance vient chercher).
  mode                   String                @default("direct")
  /// Version relevée à la connexion. Null = non déterminée : la palette ne peut
  /// alors pas viser un `typeVersion` sûr.
  n8nVersion             String?
  /// Résultat de la sonde de capacités (§4 du plan) : ce que l'API sait faire,
  /// constaté et non supposé. Null tant qu'aucune sonde n'a tourné.
  capabilities           Json?
  /// La collection d'ÉQUIPE où vivent les secrets d'automatisation de cette
  /// connexion (T-0249, T-0252). Null = pas encore choisie ; l'écran propose
  /// alors « automatisation » et la crée à la demande.
  ///
  /// ⚠️ On stocke l'ID, pas le slug « automatisation ». Un client qui renomme
  /// son dossier perdrait sinon tous ses liens en silence — et « en silence »
  /// est le mode de panne que ce chantier passe son temps à fermer.
  credentialCollectionId String?
  /// Le modèle d'IA imposé par défaut aux gabarits de CETTE instance.
  ///
  /// ⚠️ **Deux colonnes et non un JSON** : le couple décide du TYPE de nœud posé
  /// (`lmChatAnthropic` vs `lmChatOpenAi`) et de la credential attendue. Un
  /// `Json?` aurait rendu la moitié manquante indétectable sans lire la valeur —
  /// alors qu'ici « un fournisseur sans modèle » se voit dans le schéma.
  ///
  /// ⚠️ **Les deux sont posées ENSEMBLE ou pas du tout.** Un fournisseur sans
  /// son modèle imposerait un défaut inapplicable : le formulaire cocherait
  /// « utilise le modèle par défaut » et pousserait un nœud sans modèle, que N8N
  /// crée sans broncher puis refuse d'exécuter. La route les valide en couple
  /// (`modeleConnu`), et l'écran ne propose jamais l'un sans l'autre.
  ///
  /// Null tous les deux = pas de défaut : chaque gabarit fait choisir, comme
  /// avant.
  defaultModelProvider   String?
  defaultModelId         String?
  lastSeenAt             DateTime?
  secrets                N8nConnectionSecret[]
  workflows              GeneratedWorkflow[]
  credentialLinks        N8nCredentialLink[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  /// ⚠️ **Deux NULL sont DISTINCTS en PostgreSQL.** Cette contrainte à trois
  /// colonnes ne contraint donc RIEN pour les connexions d'organisation
  /// (`environmentId IS NULL`) : deux « n8n de prod » y coexisteraient sans que
  /// rien ne proteste. L'unicité de ce cas-là est tenue par un index unique
  /// PARTIEL, posé à la main dans la migration `..._automation_portee_environnement`
  /// — Prisma ne sait pas le déclarer. Retirer l'un des deux ne fait échouer
  /// aucun test de schéma ; c'est le doublon qui le dira, en production.
  @@unique([organizationId, environmentId, name])
  @@index([organizationId])
  @@index([environmentId])
}

/// Le lien entre une entrée du coffre d'ÉQUIPE et la credential N8N qu'elle
/// alimente (C-0046, T-0252 — régime B).
///
/// ⚠️ **Ce modèle acte l'inversion du §6.4** : pour ces credentials-là, le secret
/// EST recopié dans N8N, et Physalis l'y maintient à jour. L'arbitrage tient
/// parce que le client l'y mettait déjà à la main ; mais il doit rester VISIBLE,
/// et c'est cette table qui permet à l'écran de distinguer les deux régimes.
///
/// ⚠️ **`entryId` n'a délibérément PAS de clé étrangère.** Une cascade
/// effacerait la ligne quand l'entrée du coffre disparaît — c'est-à-dire
/// exactement dans le cas qu'il faut VOIR : la credential, elle, vit toujours
/// dans N8N et alimente peut-être un workflow actif. On garde le lien orphelin
/// et `entryName` pour pouvoir le nommer. L'état de référence est l'instance,
/// pas cette table (§5.4).
model N8nCredentialLink {
  id              String        @id @default(cuid())
  connectionId    String
  connection      N8nConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// L'entrée du coffre d'équipe qui fait foi. Pas de FK — cf. ci-dessus.
  entryId         String
  /// Nom de l'entrée au dernier passage, pour rester lisible si elle disparaît.
  entryName       String
  /// Le type N8N (`imap`, `smtp`…). Vit ICI et pas sur l'entrée : une entrée du
  /// coffre n'a pas à savoir que N8N existe.
  credentialType  String
  /// L'id rendu par N8N — la clé de vérité côté instance. Stable d'une mise à
  /// jour à l'autre, ce qui est TOUT l'intérêt de `PATCH /credentials/{id}` :
  /// les workflows qui le référencent survivent à une rotation.
  n8nCredentialId String
  /// Quand Physalis a poussé pour la dernière fois. Comparé à
  /// `TeamVaultEntry.updatedAt` pour dire « à jour » ou « en retard ».
  lastPushedAt    DateTime
  /// Dernier `POST /credentials/{id}/test`. `null` = jamais testée — ce qui
  /// n'est pas « en échec », et l'écran doit les distinguer.
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestError   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  /// Une entrée alimente au plus UNE credential par connexion : sans ça, deux
  /// poussées créeraient deux credentials et la rotation n'en mettrait qu'une
  /// à jour, en silence.
  @@unique([connectionId, entryId])
  @@index([connectionId])
}

/// Workflow poussé par Physalis sur l'instance du client (C-0046, phase B).
///
/// ⚠️ L'état de référence est **l'instance**, pas cette table : le client peut
/// modifier ou supprimer un workflow à la main. La réconciliation compare et
/// marque `orphan` ; Physalis ne réécrit jamais en silence (§5.4).
model GeneratedWorkflow {
  id               String        @id @default(cuid())
  connectionId     String
  connection       N8nConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// L'id rendu par N8N — la clé de vérité côté instance.
  n8nWorkflowId    String
  name             String
  /// Le gabarit qui l'a produit, ou null pour une génération libre (phase D).
  /// ⚠️ C'est la matière du **taux de gabarit**, métrique économique du
  /// chantier (§7) : le coût du produit est la moyenne pondérée par ce taux.
  gabarit          String?
  /// Les paramètres saisis pour instancier le gabarit (T-0254). Null pour une
  /// génération libre, un workflow adopté, ou tout ce qui a été poussé AVANT
  /// cette colonne.
  ///
  /// ⚠️ Sans eux, on ne peut ni détecter qu'un gabarit a changé, ni le
  /// réappliquer — et les rétro-déduire du JSON serait la devinette que ce
  /// chantier refuse partout ailleurs.
  ///
  /// ⚠️ Ce ne sont PAS des secrets : des références (projet, environnement,
  /// tag, collection, cadence), déjà présentes dans `pushedJson`. Si un gabarit
  /// venait un jour à prendre une VALEUR en paramètre, c'est ici qu'il faudrait
  /// s'arrêter pour y penser.
  gabaritParams    Json?
  /// Vrai si Physalis a ADOPTÉ ce workflow au lieu de le produire (T-0250).
  ///
  /// ⚠️ `gabarit: null` ne suffit pas à distinguer les origines : il vaut null
  /// pour la génération libre AUSSI. Sans ce booléen, un workflow adopté — qui
  /// n'a rien coûté en modèle — creuserait le taux de gabarit (§7) comme s'il
  /// avait été généré, et fausserait la métrique économique du chantier.
  adopted          Boolean       @default(false)
  /// Le JSON RÉELLEMENT poussé, pour diff, relecture et re-génération.
  /// (Le plan §5.1 l'appelait `palette` ; renommé parce que la palette est la
  /// liste blanche de nœuds, pas le workflow.)
  pushedJson       Json
  /// draft | validated | dry_run_ok | active | broken | orphan
  state            String        @default("draft")
  /// Conversation d'origine (phase C). Null tant qu'il n'y a pas de chat.
  conversationId   String?
  lastExecutionAt  DateTime?
  lastErrorSummary String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([connectionId, n8nWorkflowId])
  @@index([connectionId])
}

/// Secret chiffré d'une N8nConnection, typé par `kind` (api_key).
/// Calque exact de CiConnectionSecret.
model N8nConnectionSecret {
  id             String        @id @default(cuid())
  connectionId   String
  connection     N8nConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  kind           String
  encryptedValue String
  iv             String
  tag            String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([connectionId, kind])
}

/// Une autorisation OAuth détenue par Physalis pour le compte du client, et
/// posée sur les N instances de sa portée — la custody de [T-0260].
///
/// ⚠️ **L'application OAuth reste celle du CLIENT (BYO).** Physalis ne porte
/// aucune vérification : `clientId` et le `client_secret` chiffré viennent du
/// client, exactement comme `SsoConfig` le fait déjà pour le SSO Enterprise.
///
/// ⚠️ **La portée est le PROJET, pas l'environnement** — et c'est un cran
/// au-dessus de `N8nConnection` à dessein. Toute la raison d'être de cet objet
/// est qu'UNE autorisation serve les DEUX instances d'un projet (`production` et
/// `staging`) ; la porter par environnement obligerait à consentir deux fois,
/// c'est-à-dire à ne rien résoudre. `null` = toute l'organisation.
///
/// ⚠️ **`projectId` est une BARRIÈRE D'ACCÈS, pas un rangement**, pour la même
/// raison que `N8nConnection.environmentId` : lire par
/// `porteeCredentialOAuthWhere` (lib/automation/portee.ts), jamais par un filtre
/// maison — c'est lui qui passe par `accessibleProjectsWhere`, lequel porte la
/// règle du `ProjectMember.hidden`.
model AutomationOAuthCredential {
  id               String                  @id @default(cuid())
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  /// Le type de credential N8N visé (`gmailOAuth2`, `googleSheetsOAuth2Api`…).
  /// ⚠️ Doit être un type OAuth du catalogue : c'est lui qui décide des points
  /// d'autorisation et des portées demandées.
  credentialType   String
  /// L'identifiant public de l'application OAuth du client. En clair, comme
  /// `SsoConfig.oidcClientId` — ce n'est pas un secret, seul l'est le `secret`.
  clientId         String
  /// ⚠️ **QUI A CONSENTI, et c'est indispensable, pas décoratif.** Un jeton OAuth
  /// porte l'identité d'UNE personne : le jour où elle part, ou révoque l'accès
  /// depuis son compte Google, la connexion meurt pour toute l'équipe. Sans ce
  /// champ, personne ne peut prévoir ni diagnostiquer cette panne.
  ///
  /// `onDelete: SetNull` et pas `Cascade` : le départ de la personne ne doit PAS
  /// effacer l'autorisation qui fait tourner la production — il doit se voir.
  consentedById    String?
  consentedBy      User?                   @relation("automationOAuthConsent", fields: [consentedById], references: [id], onDelete: SetNull)
  /// Le compte TIERS qui a consenti (l'adresse Google), pour l'afficher tel quel.
  /// Distinct de `consentedById` : la personne peut avoir autorisé un compte de
  /// service ou une adresse partagée, et c'est celle-là qu'il faut révoquer.
  consentedSubject String?
  consentedAt      DateTime?
  secrets          AutomationOAuthSecret[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  poses            AutomationOAuthPose[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([projectId])
}

/// Le secret chiffré d'une autorisation OAuth, typé par `kind`
/// (`client_secret` | `refresh_token` | `access_token`) — calque exact de
/// `N8nConnectionSecret`.
///
/// ⚠️ **Aucun `@map` sur les colonnes chiffrées, et c'est une règle, pas un
/// hasard.** Le garde-fou `tests/lib/rekey-registry.test.ts` compare le registre
/// de rotation aux CHAMPS Prisma, pas aux COLONNES SQL : c'est précisément par
/// là que `admin.sso_configs` — seul modèle à `@map` snake_case — est passé
/// entre les mailles, au point que la rotation du 2026-08-01 l'a sauté en
/// annonçant « 0 erreur ». Sans `@map`, le garde-fou ne peut plus être contourné.
///
/// ⚠️ Ce modèle DOIT figurer au registre de `scripts/rekey-encryption.mjs`. Un
/// triplet absent n'échoue pas : il est ignoré en silence, et ne se découvre
/// qu'à la destruction de l'ancienne clé, quand il est trop tard.
/// La POSE d'une autorisation OAuth sur une instance N8N ([T-0260]).
///
/// ⚠️ **Cette ligne EST la règle d'écriture unique.** Mesuré en [T-0259] :
/// repousser une copie datée d'un jeton détruit un jeton tourné, et l'API
/// publique de N8N ne rend jamais `oauthTokenData` en lecture — on ne peut donc
/// même pas comparer avant d'écrire. La seule discipline tenable est « on écrit
/// une fois, puis plus jamais », et c'est l'existence de cette ligne qui le fait
/// respecter.
///
/// ⚠️ La SEULE réécriture admise est celle qui suit un nouveau consentement :
/// `AutomationOAuthCredential.consentedAt > posedAt`. C'est un signal externe
/// fiable — le client a refait le tour de l'écran Google — par opposition à une
/// horloge, qui repousserait une copie périmée.
///
/// ⚠️ **Distinct de `N8nCredentialLink`, et pas par paresse.** Celui-là relie une
/// ENTRÉE DU COFFRE à une credential (régime B, maintenue à jour) ; celui-ci
/// relie une AUTORISATION à une credential, écrite une fois. Les fondre ferait
/// promettre à l'écran un « maintien à jour » qui, sur de l'OAuth, casse la
/// connexion.
model AutomationOAuthPose {
  id              String                    @id @default(cuid())
  credentialId    String
  credential      AutomationOAuthCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  connectionId    String
  connection      N8nConnection             @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// L'id rendu par N8N — la clé de vérité côté instance, celle que les
  /// workflows référencent.
  n8nCredentialId String
  posedAt         DateTime
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([credentialId, connectionId])
  @@index([connectionId])
}

model AutomationOAuthSecret {
  id             String                    @id @default(cuid())
  credentialId   String
  credential     AutomationOAuthCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  kind           String
  encryptedValue String
  iv             String
  tag            String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([credentialId, kind])
}

/// Connexion CI/CD au niveau organisation (cf. modèle public schema.prisma).
model CiConnection {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  provider       String                  @default("github")
  issuer         String?
  secrets        CiConnectionSecret[]
  projects       Project[]
  syncTargets    EnvironmentSyncTarget[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Secret chiffré d'une CiConnection, typé par `kind` (redeploy_token |
/// registry_url | registry_user | registry_token). Cf. modèle public.
model CiConnectionSecret {
  id             String       @id @default(cuid())
  connectionId   String
  connection     CiConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  kind           String
  encryptedValue String
  iv             String
  tag            String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([connectionId, kind])
}

/// Cible de synchronisation sortante d'un environnement (Vercel, puis
/// Render/Railway). Cf. modèle public + lib/sync/.
model EnvironmentSyncTarget {
  id                    String       @id @default(cuid())
  environmentId         String
  environment           Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  ciConnectionId        String
  ciConnection          CiConnection @relation(fields: [ciConnectionId], references: [id], onDelete: Cascade)
  externalProjectId     String
  externalProjectName   String?
  externalEnvironmentId String?
  externalServiceId     String?
  targets               String[]     @default([])
  tagFilter             String[]     @default([])
  lastSyncAt            DateTime?
  lastSyncStatus        String?
  lastSyncError         String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([environmentId, ciConnectionId])
  @@index([ciConnectionId])
  @@index([lastSyncStatus])
}

/// Doc projet récupérée depuis le repo GitHub (readme / technique / sécurité) et
/// mise en cache. Une ligne n'existe QUE si le fichier existait au dernier fetch
/// → l'absence de ligne = fichier absent. Cf. physalis.md.
model ProjectDoc {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      ProjectDocKind
  content   String // markdown brut
  fetchedAt DateTime       @default(now())

  @@unique([projectId, kind])
  @@index([projectId])
}

enum ProjectDocKind {
  README
  TECHNICAL
  SECURITY
}

model Policy {
  id            String       @id @default(cuid())
  /// "github" | "gitlab" | "bitbucket". String, pas enum PG.
  provider      String       @default("github")
  /// Issuer OIDC ; null = défaut du provider (github.com / gitlab.com).
  /// Rempli pour GitLab self-hosted et Bitbucket.
  issuer        String?
  repo          String
  /// github : fichier workflow ; gitlab/bitbucket : environment CI ("" = tout).
  workflow      String
  branch        String
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "server" (défaut) | "mobile" — cf. OidcPolicy.kind côté admin.
  kind          String       @default("server")
  /// Renseigné SSI kind = "server".
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  /// Renseigné SSI kind = "mobile".
  mobileAppId   String?
  mobileApp     MobileApp?   @relation(fields: [mobileAppId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  /// Deux uniques : cf. la note du modèle OidcPolicy — un UNIQUE ne dédoublonne
  /// pas les lignes dont une colonne est NULL.
  @@unique([provider, repo, workflow, branch, projectId, environmentId], map: "Policy_provider_repo_wf_branch_proj_env_key")
  @@unique([provider, repo, workflow, branch, projectId, mobileAppId], map: "Policy_provider_repo_wf_branch_proj_mobile_key")
  @@index([provider, repo, workflow, branch])
  @@index([projectId])
  @@index([environmentId])
  @@index([mobileAppId])
}

model Service {
  id            String   @id @default(cuid())
  name          String
  url           String?
  encryptedData String
  iv            String
  tag           String
  /// Tags techniques pour le filtrage dans les intégrations (N8n/Make).
  /// Distinct de `Secret.category` (organisation visuelle UI). Ex: ["stripe", "production"].
  tags          String[] @default([])
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Comptes applicatifs dont l'URL pointe vers ce service (backend).
  appAccounts AppAccount[]

  // Rotation REMINDER (Phase B) — rappel d'âge + rotation assistée des creds DU
  // service (Stripe-like). Pas de versioning → historique capé à 3.
  rotationEnabled      Boolean   @default(false)
  rotationIntervalDays Int?
  rotationLastAt       DateTime?
  rotationNextAt       DateTime?
  rotationLastStatus   String?
  rotationHistory      Json?

  // Hook de rotation des COMPTES liés (Phase C) — service "backend". Les comptes
  // en stratégie WEBHOOK liés à ce service rotent via ce hook. Optionnel (un
  // service Stripe-like n'en a pas). rotationExecMode : "AGENT" | "DIRECT".
  rotationWebhookUrl String?
  rotationHookToken  String?
  rotationExecMode   String?

  // Cible de rotation DATABASE des COMPTES liés (A3) — service "base de données
  // managée" (Supabase/RDS/Neon…). La connexion (host/port/base) vit ici, AINSI
  // QUE des identifiants admin DB DÉDIÉS (dbUser + mot de passe chiffré
  // dbPw*), DISTINCTS des creds « interface/dashboard » du service
  // (encryptedData {user,password}). Un compte lié en stratégie DATABASE rote
  // via cette connexion admin. dbType en TEXT (pas l'enum : absent du schéma public).
  dbType        String?
  dbHost        String?
  dbPort        Int?
  dbName        String?
  /// Identifiant admin de connexion DB (ex. `postgres` ou `postgres.<ref>` via
  /// pooler Supabase). Plaintext comme dbHost (le secret = le mot de passe).
  dbUser        String?
  /// Mot de passe admin DB, chiffré (AES-GCM, comme les autres secrets).
  dbPwEncrypted String?
  dbPwIv        String?
  dbPwTag       String?

  @@index([projectId])
  @@index([rotationNextAt])
}

model AppAccount {
  id            String   @id @default(cuid())
  name          String
  encryptedData String
  iv            String
  tag           String
  /// Tags techniques pour le filtrage dans les intégrations (N8n/Make).
  tags          String[] @default([])
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// URL/contexte du compte : lié à UN environnement (frontend) OU UN service
  /// (backend) — XOR au niveau app. L'URL affichée vient du lien. SetNull si la
  /// cible est supprimée (le compte survit, sans URL).
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  serviceId     String?
  service       Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // Rotation (Phase B REMINDER + Phase C WEBHOOK). Historique capé à 3.
  rotationEnabled      Boolean   @default(false)
  rotationIntervalDays Int?
  rotationLastAt       DateTime?
  rotationNextAt       DateTime?
  rotationLastStatus   String?
  rotationHistory      Json?
  /// Stratégie de rotation du compte : null/"REMINDER" (rappel manuel assisté,
  /// défaut), "WEBHOOK" (hook côté app) ou "DATABASE" (rôle/utilisateur d'une DB
  /// managée via la connexion admin du service lié).
  rotationStrategy     String?
  /// WEBHOOK : "AGENT" (hook interne réseau Docker, l'agent appelle) ou "DIRECT"
  /// (hook joignable depuis Physalis). rotationWebhookUrl + token Bearer optionnel.
  rotationExecMode     String?
  rotationWebhookUrl   String?
  rotationHookToken    String?
  /// DATABASE : type de cible — null/"role" (rôle PostgreSQL → ALTER ROLE,
  /// défaut) ou "supabase_auth" (utilisateur Supabase Auth → UPDATE auth.users,
  /// le `user` du compte = l'email). Le SQL exécuté par l'admin du service.
  rotationDbTarget     String?

  @@index([projectId])
  @@index([rotationNextAt])
  @@index([environmentId])
  @@index([serviceId])
}

model Environment {
  id             String                  @id @default(cuid())
  name           String
  projectId      String
  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url            String?
  dockerCompose  String?
  serverId       String?
  server         Server?                 @relation(fields: [serverId], references: [id], onDelete: SetNull)
  deployPath     String?
  /// Ordre d'affichage dans le projet (glisser-déposer des paramètres).
  /// À égalité (0 par défaut), départage par nom.
  position       Int                     @default(0)
  secrets        Secret[]
  tokens         MachineToken[]
  policies       Policy[]
  liveApis       Api[]                   @relation("apiLiveEnv")
  testApis       Api[]                   @relation("apiTestEnv")
  syncTargets    EnvironmentSyncTarget[]
  /// Comptes applicatifs dont l'URL pointe vers cet environnement (frontend).
  appAccounts    AppAccount[]
  /// Instances N8N portées par CET environnement (T-0258). Cf. l'avertissement
  /// sur `N8nConnection.environmentId` : c'est une barrière d'accès.
  n8nConnections N8nConnection[]
  deployments    Deployment[]

  @@unique([projectId, name])
  @@index([serverId])
}

/// Suivi des déploiements serveur (C-0051) — calque du registre mobile
/// (`MobileRelease`). Cf. documentation/plans/guide-installation-projet.md §3.
///
/// Deux moments d'écriture, à ne JAMAIS confondre :
///   1. `/api/deploy` ouvre la ligne quand il SERT le bundle (constaté) ;
///   2. `/api/deploy/report` y pose l'issue que le pipeline DÉCLARE.
/// Les deux se rejoignent sur l'identité du run tirée du jeton OIDC signé. Une
/// ligne sans bundle servi (`bundleServedCount = 0`) est un déploiement que
/// Physalis n'a pas orchestré : c'est une information de sécurité, pas un trou.
///
/// Les paliers d'attente (long / anormal / expiré) se CALCULENT depuis
/// `authorizedAt` : ils ne sont jamais écrits. Rétention : les 25 derniers par
/// environnement, purgés à l'écriture (lib/deployment.ts).
model Deployment {
  id                String      @id @default(cuid())
  projectId         String
  environmentId     String
  environment       Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  /// admin.policies.id (SaaS) ou Policy.id (self-host). Sans FK : autre schéma.
  policyId          String?
  /// github | gitlab | bitbucket
  provider          String
  repo              String
  /// matchKey OIDC : fichier workflow (github) ou environment CI (gitlab/bitbucket).
  workflow          String
  branch            String
  runId             String
  /// Texte : Bitbucket distingue ses relances par un UUID.
  runAttempt        String      @default("1")
  sha               String?
  /// requested (bundle servi, pas encore de rapport) | succeeded | failed
  status            String      @default("requested")
  /// D'où vient l'issue : "reported" (le pipeline l'a DÉCLARÉE via
  /// /api/deploy/report) | "platform" (Physalis l'a CONSTATÉE en lisant le run
  /// chez GitHub/GitLab/Bitbucket). null tant que la ligne est en attente.
  statusSource      String?
  /// Nombre de bundles servis à ce run (un `deploy.yml` en prend deux : build
  /// puis deploy). 0 = rapport reçu sans bundle servi → non corrélé.
  bundleServedCount Int         @default(0)
  authorizedAt      DateTime?
  reportedAt        DateTime?
  detail            String?
  createdAt         DateTime    @default(now())

  @@unique([environmentId, provider, runId, runAttempt])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([environmentId, createdAt(sort: Desc)])
}

model Secret {
  id                       String            @id @default(cuid())
  key                      String
  encryptedValue           String
  iv                       String
  tag                      String
  category                 String?
  /// Tags techniques pour le filtrage dans les intégrations (N8n/Make).
  /// Distinct de `category` (organisation visuelle UI). Ex: ["postgres", "production"].
  tags                     String[]          @default([])
  environmentId            String
  environment              Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  versions                 SecretVersion[]
  rotationEnabled          Boolean           @default(false)
  rotationStrategy         RotationStrategy?
  rotationIntervalDays     Int?
  rotationLastAt           DateTime?
  rotationNextAt           DateTime?
  rotationLastStatus       String? // "success" | "error" | null
  rotationErrorCount       Int               @default(0)
  /// Mode d'exécution de la rotation DATABASE : "AGENT" (DB Docker-interne, sidecar
  /// agent self-rotation) ou "DIRECT" (DB managée joignable, chemin N8n). Défaut AGENT.
  rotationExecMode         String            @default("AGENT")
  /// Demande de rotation immédiate (bouton « Forcer ») : bypass la fenêtre horaire
  /// planifiée. Posé par /rotation/force (mode AGENT), purgé au report. null = pas de force.
  rotationForceRequestedAt DateTime?
  dbHost                   String?
  dbPort                   Int?
  dbName                   String?
  dbType                   DatabaseType?
  dbUser                   String?
  rotationNeedsFullDeploy  Boolean           @default(false)
  rotationWebhookUrl       String?
  /// Stratégie WEBHOOK (Phase C) — libellé de la cible (ex. « Compte admin de l'app »)
  /// pour lever le flou UX, et token Bearer optionnel envoyé au hook pour l'auth.
  rotationHookLabel        String?
  rotationHookToken        String?
  jwtRedeployWebhookUrl    String?
  apiKeyId                 String?
  apiKey                   ApiKey?           @relation("secretApiKey", fields: [apiKeyId], references: [id], onDelete: SetNull)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@unique([environmentId, key])
  @@index([rotationNextAt])
}

enum RotationStrategy {
  DATABASE
  JWT_SECRET
  WEBHOOK
  REMINDER
  API_KEY
}

/// Historique des valeurs d'un Secret (Phase 10 — versioning).
/// Chaque row = un snapshot de l'ancienne valeur juste avant un update.
/// Rétention : 50 versions max par secret (cleanup au INSERT côté code).
/// UNIQUE(secretId, version) pour gérer les race conditions sur
/// MAX(version)+1 — retry côté code en cas de conflit.
model SecretVersion {
  id             String   @id @default(cuid())
  secretId       String
  secret         Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  encryptedValue String
  iv             String
  tag            String
  version        Int
  createdById    String?
  createdBy      User?    @relation("secretVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@unique([secretId, version])
  @@index([secretId, version(sort: Desc)])
}

/// Une application publiable = un couple (projet, plateforme, identifiant magasin).
/// Cf. documentation/plans/deploiement-mobile.md §4.2. Phase 1 (socle credentials).
/// Volontairement absent de prisma/schema.prisma (comme ProjectBackupConfig) :
/// tenant-only, aucun consommateur admin-side à ce stade. La migration crée la
/// table via un DO block hand-écrit (motif SecretRequest), pas via un diff
/// `prisma migrate dev` sur schema.prisma.
model MobileApp {
  id               String             @id @default(cuid())
  projectId        String
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "android" | "ios". String, pas enum PG (cf. Policy.provider — un ALTER
  /// TYPE sur un enum tenant-only plante le déploiement admin, mémoire
  /// orgrole-enum-tenant-only).
  platform         String
  /// applicationId Android (com.exemple.app) ou bundleId iOS.
  bundleId         String
  displayName      String
  /// Team ID Apple / identifiant développeur Play. Informatif + préremplissage.
  vendorTeamId     String?
  /// Étiquette de regroupement cosmétique ("Production"/"Staging"/"Dev"),
  /// orthogonale à `platform` — décidé §10.5 du plan (2026-08-14). Purement
  /// UI, non contrainte : le repliage visuel par groupe est différé.
  group            String?
  /// Version marketing servie au CI (CFBundleShortVersionString / versionName),
  /// ex. "1.4". Fixée à la main : bumper une version est une décision humaine.
  versionName      String?
  /// Dernier numéro de build SERVI (CFBundleVersion / versionCode). À
  /// initialiser au dernier numéro déjà publié sur le store ; chaque
  /// POST /api/deploy/mobile sert `buildNumber + 1` et le persiste. Compteur
  /// LOCAL (repli §4.5 du plan) : la lecture autoritative du magasin est la
  /// Phase 5. Des trous après un échec de build sont sans conséquence (un
  /// numéro de build doit croître, pas être contigu).
  buildNumber      Int                @default(0)
  /// Coupe-circuit de publication PAR APP (donc par plateforme). true =>
  /// /api/deploy/mobile répond 403 « publications en pause » à un pipeline
  /// pourtant autorisé — gel manuel depuis la console, audité, sans toucher au
  /// CI. Même motif que Secret.rotationPaused / Project.rotationPaused. La
  /// FRONTIÈRE (policy) reste intacte : c'est un veto ponctuel, pas une
  /// révocation d'accès.
  deployPaused     Boolean            @default(false)
  /// Dernier rapport de « Vérifier le matériel », tel quel. Gardé pour être
  /// affiché à l'ouverture de l'onglet sans redemander aux magasins — le
  /// rapport coûte quatre appels sortants. Null = jamais vérifié.
  lastVerifyReport Json?
  lastVerifiedAt   DateTime?
  credentials      MobileCredential[]
  releases         MobileRelease[]
  policies         Policy[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([projectId, platform, bundleId])
  @@index([projectId])
}

/// Matériel de signature et accès magasin (keystore, certificat, clé d'API…).
/// La valeur est TOUJOURS du base64 (même un champ texte comme un mot de
/// passe) : un seul chemin de codage. Séparé de `Secret` à dessein — un
/// `Secret` coule dans le `.env` du bundle serveur, un keystore base64 y
/// serait une fuite gratuite (plan §4.2).
model MobileCredential {
  id              String                    @id @default(cuid())
  appId           String
  app             MobileApp                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// "android_keystore" | "android_keystore_password" | "android_key_alias" |
  /// "android_key_password" | "play_service_account" | "ios_p12" |
  /// "ios_p12_password" | "ios_profile" | "asc_api_key" | "asc_key_id" |
  /// "asc_issuer_id" — cf. plan §4.4. String, pas enum PG (même motif).
  kind            String
  /// Nom de fichier d'origine (restitué au CI ; sert aussi à l'UI).
  filename        String?
  sizeBytes       Int
  /// Empreinte SHA-256 du CLAIR — détecte un remplacement et corrèle un
  /// bundle à ce qui a réellement signé, sans révéler la valeur.
  sha256          String
  encryptedValue  String
  iv              String
  tag             String
  /// Extraite du matériel à l'import (certificat X.509, profil provisioning).
  /// Null si le type n'a pas de notion d'expiration (mot de passe, clé .p8).
  expiresAt       DateTime?
  /// Dernier rappel d'expiration envoyé — anti-spam, motif
  /// ProjectBackupConfig.overdueAlertedAt. Phase 4 (pas encore émis en Phase 1).
  expiryAlertedAt DateTime?
  versions        MobileCredentialVersion[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([appId, kind])
  @@index([expiresAt])
}

/// Une livraison. Physalis ne détient PAS l'artefact (§3.2) — seulement son
/// signalement : quelle version est partie sur quelle piste, signée par quel
/// matériel, poussée par quel pipeline. C'est la réponse en un écran à une
/// question qui vit aujourd'hui dans trois consoles et un canal Slack (§5.3).
model MobileRelease {
  id             String    @id @default(cuid())
  appId          String
  app            MobileApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// "internal" | "alpha" | "beta" | "production" (Play) ;
  /// "testflight" | "appstore" (iOS).
  ///
  /// ⚠️ Écart au plan, assumé : la ligne naît AU MOMENT OÙ LE BUNDLE EST SERVI,
  /// donc avant que la piste soit connue — le CI ne la décide qu'à l'upload.
  /// Elle vaut donc "pending" jusqu'au /report. Créer la ligne plus tôt est ce
  /// qui rend la corrélation matériel↔version VRAIE : elle est écrite par
  /// Physalis à partir de ce qu'il a réellement servi, pas déclarée après coup
  /// par le pipeline.
  track          String    @default("pending")
  /// versionName / CFBundleShortVersionString.
  versionName    String?
  /// versionCode / CFBundleVersion. Texte et non entier : iOS accepte "1.2.3".
  buildNumber    String
  /// "reported" (le CI l'a dit) | "store" (relu au magasin, Phase 5).
  statusSource   String    @default("reported")
  /// requested | uploaded | processing | in_review | live | halted | rejected | failed
  status         String    @default("requested")
  statusDetail   String?
  /// Empreintes du matériel SERVI, par kind : { "ios_p12": "AB12…" }. Répond à
  /// « quel certificat a signé cette version » sans révéler la moindre valeur —
  /// et permet de repérer qu'un build est parti sous un certificat depuis
  /// remplacé.
  credentialsSha Json      @default("{}")
  /// Identité du pipeline (claims OIDC déjà vérifiés) — « qui a publié ça ».
  ciProvider     String?
  ciRepo         String?
  ciRef          String?
  requestedAt    DateTime  @default(now())
  reportedAt     DateTime?
  storeSyncedAt  DateTime?

  @@unique([appId, track, buildNumber])
  @@index([appId, requestedAt(sort: Desc)])
  @@index([status])
}

/// Calque de SecretVersion : snapshot avant remplacement, même colonnes,
/// même @@unique, même limite de rétention (cf. lib/versioning.ts).
model MobileCredentialVersion {
  id             String           @id @default(cuid())
  credentialId   String
  credential     MobileCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  encryptedValue String
  iv             String
  tag            String
  version        Int
  createdById    String?
  createdBy      User?            @relation("mobileCredentialVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@unique([credentialId, version])
  @@index([credentialId, version(sort: Desc)])
}

model MachineToken {
  id            String      @id @default(cuid())
  name          String
  tokenHash     String      @unique
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdById   String?
  createdBy     User?       @relation("machineTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())
  revokedAt     DateTime?
}

/// UserToken (Phase 11a) — token Bearer scopé à un User (vs MachineToken
/// scopé project+env). Donne accès READ aux projets dont l'user est
/// ProjectMember, à son rôle effectif (VIEWER+). Cas d'usage : workflow
/// N8n / Make / scripts qui touchent plusieurs projets sous le même
/// compte. Préfixe brut `sv_user_<32 hex>` distinguable de `sv_<hex>`.
model UserToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Libellé libre choisi par l'user, ex: "N8n Voyages workflows".
  name       String
  /// SHA-256 du token brut. UNIQUE pour le lookup au runtime.
  tokenHash  String    @unique
  /// 12 premiers chars du token (`sv_user_xxxx`) — affichage UI sans
  /// exposer le secret après la création.
  prefix     String
  /// Optionnel — null = jamais.
  expiresAt  DateTime?
  lastUsedAt DateTime?
  /// Révocation soft (revokedAt = now()) — évite le hard DELETE pour
  /// préserver les liens `INTEGRATION_*_FETCH` dans les AccessLog.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// OrgToken (Phase 11c) — token Bearer scopé à une Organization. Survit
/// au départ du user créateur (createdById SetNull, pas Cascade) — c'est
/// le différenciateur principal vs UserToken. Cas d'usage : workflows
/// N8n / Make institutionnels pérennes.
///
/// Permissions explicites :
///   - allowedScopes : enum OrgTokenScope (READ uniquement en V1)
///   - allowedProjectIds : tableau d'IDs de projets autorisés
///   - allProjects : boolean — true ouvre l'accès à tous les projets
///                   actuels et FUTURS de l'org
///
/// Sémantique :
///   - allProjects=false ET allowedProjectIds=[]   → AUCUN accès (état
///     invalide, à éviter via UI qui force la sélection)
///   - allProjects=false ET allowedProjectIds=[..] → seulement ces projets
///   - allProjects=true                            → tous les projets
///                                                   (allowedProjectIds ignoré)
///
/// Préfixe brut : `sv_org_<32 hex>`. OrgSecrets (lus via le panel
/// `/orgs/[slug]/secrets`) ne sont JAMAIS accessibles via OrgToken par
/// design — pas de scope dédié.
model OrgToken {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  tokenHash         String          @unique
  /// 12 premiers chars du token (`sv_org_xxxx`) pour affichage UI.
  prefix            String
  /// true → accès à tous les projets actuels ET FUTURS de l'org.
  /// Marker explicite (vs tableau vide ambigu) — vide = aucun accès.
  allProjects       Boolean         @default(false)
  allowedProjectIds String[]        @default([])
  allowedScopes     OrgTokenScope[] @default([])
  expiresAt         DateTime?
  lastUsedAt        DateTime?
  revokedAt         DateTime?
  /// SetNull au DELETE user → le token survit (différenciateur vs UserToken).
  createdById       String?
  createdBy         User?           @relation("orgTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())

  @@index([organizationId])
  @@index([expiresAt])
}

enum OrgTokenScope {
  SECRETS_READ
  SERVICES_READ
  ACCOUNTS_READ
  PROJECTS_LIST
}

model ProjectMember {
  id        String      @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole @default(VIEWER)
  hidden    Boolean     @default(false)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

enum Role {
  ADMIN
  MEMBER
  SUPERADMIN
}

enum OrgRole {
  OWNER
  ADMIN
  ADMIN_DEV
  DEV
  MEMBER
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

model VaultEntry {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Collection perso optionnelle (V2.0). NULL = "Sans catégorie".
  /// SetNull on delete : supprimer une collection ne supprime pas ses entrées.
  collectionId        String?
  collection          VaultCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  /// Forme de l'entrée : LOGIN | SECRET | LIST | NOTE (cf.
  /// lib/vault-entry-types.ts). TEXTE et pas enum PG : un enum tenant-only
  /// absent de `public` casse le deploy admin, et une 5ᵉ forme demanderait
  /// un ALTER TYPE … ADD VALUE avec le même piège.
  type                String           @default("LOGIN")
  name                String
  url                 String?
  username            String?
  encryptedPassword   String?
  passwordIv          String?
  passwordTag         String?
  encryptedTotpSecret String?
  totpSecretIv        String?
  totpSecretTag       String?
  /// Score de force du mot de passe (0-4, heuristique à la zxcvbn), calculé
  /// côté serveur au save. NULL = pas de mot de passe. Renseigné pour le
  /// seul type LOGIN — le scorer sur une clé d'API polluerait le filtre
  /// « mots de passe faibles ».
  passwordStrength    Int?
  /// Charge utile chiffrée des types LIST et NOTE (JSON AES-256-GCM :
  /// {items:[{label,value}]} ou {text}). Libellés compris — ils en disent
  /// plus long qu'une URL. NULL pour LOGIN et SECRET, qui n'utilisent que
  /// les colonnes ci-dessus.
  encryptedData       String?
  dataIv              String?
  dataTag             String?
  /// Nombre d'items d'une LIST, EN CLAIR : permet d'afficher « N secrets »
  /// dans la liste sans déchiffrer. NULL hors LIST.
  itemCount           Int?
  /// Clé SSH (type SSH_KEY, C-0050) — clé publique au format OpenSSH et
  /// empreinte SHA256, EN CLAIR (non secrètes, affichées sans déchiffrer).
  /// La clé privée PKCS#8 est dans `encryptedData` et ne sort jamais vers le
  /// navigateur. NULL hors SSH_KEY.
  sshPublicKey        String?
  sshFingerprint      String?
  tags                String[]         @default([])
  favorite            Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([userId])
  @@index([collectionId])
}

/// Collection perso d'un User (V2.0 — coffre personnel).
/// Mirror simplifié de TeamVaultCollection : pas de members, scope user
/// strict (un user n'accède qu'à SES collections). Déclenchant `slug`
/// unique par user pour permettre des URLs propres + import idempotent.
model VaultCollection {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  entries   VaultEntry[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, slug])
  @@index([userId])
}

model TeamVaultCollection {
  id             String            @id @default(cuid())
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  entries        TeamVaultEntry[]
  notifications  Notification[]
  members        TeamVaultMember[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, slug])
  @@unique([projectId, slug])
  @@index([organizationId])
  @@index([projectId])
}

model TeamVaultEntry {
  id                  String              @id @default(cuid())
  collectionId        String
  collection          TeamVaultCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// Forme de l'entrée : LOGIN | SECRET | LIST | NOTE (cf.
  /// lib/vault-entry-types.ts). Miroir de `VaultEntry.type`, et TEXTE pour la
  /// même raison : un enum tenant-only absent du schéma `public` casse le
  /// deploy admin, et une 5ᵉ forme demanderait un ALTER TYPE … ADD VALUE avec
  /// le même piège (C-0047).
  type                String              @default("LOGIN")
  name                String
  url                 String?
  username            String?
  encryptedPassword   String?
  passwordIv          String?
  passwordTag         String?
  encryptedTotpSecret String?
  totpSecretIv        String?
  totpSecretTag       String?
  /// Charge utile chiffrée des types LIST et NOTE (JSON AES-256-GCM :
  /// {items:[{label,value}]} ou {text}). Libellés compris — ils en disent plus
  /// long qu'une URL. NULL pour LOGIN et SECRET, qui n'utilisent que les
  /// colonnes ci-dessus.
  encryptedData       String?
  dataIv              String?
  dataTag             String?
  /// Nombre d'items d'une LIST, EN CLAIR : permet d'afficher « N secrets »
  /// sans déchiffrer. NULL hors LIST.
  itemCount           Int?
  tags                String[]            @default([])
  favorite            Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Rotation REMINDER (Phase B) — rappel d'âge + rotation assistée sur le mot de
  // passe (encryptedPassword). Historique capé à 3 dans rotationHistory.
  rotationEnabled      Boolean   @default(false)
  rotationIntervalDays Int?
  rotationLastAt       DateTime?
  rotationNextAt       DateTime?
  rotationLastStatus   String?
  rotationHistory      Json?

  /// Destinations d'alerte dont le webhook pointe sur cette entrée (SetNull).
  notificationDestinations NotificationDestination[]

  @@index([collectionId])
  @@index([rotationNextAt])
}

model TeamVaultMember {
  id           String              @id @default(cuid())
  collectionId String
  userId       String
  role         VaultRole           @default(VIEWER)
  collection   TeamVaultCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())

  @@unique([collectionId, userId])
}

enum VaultRole {
  OWNER
  EDITOR
  VIEWER
}

model AccessLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  environmentId  String?
  actorUserId    String?
  actorUser      User?         @relation("accessLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserEmail String?
  actorTokenId   String?
  actorTokenName String?
  action         AccessAction
  targetType     String?
  targetId       String?
  secretKey      String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model OneTimeShare {
  id               String        @id @default(cuid())
  tokenHash        String        @unique
  ciphertext       String
  iv               String
  title            String?
  passwordHash     String?
  passwordAttempts Int           @default(0)
  createdById      String
  createdBy        User          @relation("oneTimeShareCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdByEmail   String
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  consumedAt       DateTime?
  viewedFromIp     String?
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([createdById])
  @@index([expiresAt])
}

