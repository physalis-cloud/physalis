// Schéma "tenant" — pas de multiSchema, queries Prisma émises non-qualifiées
// (`SELECT * FROM "User"`) pour permettre le routing par `search_path` en
// Phase 3 (schema-per-tenant `client_<slug>`).
//
// Ce fichier est une COPIE des modèles tenant de prisma/schema.prisma sans
// les annotations @@schema. Il ne sert QU'à la codegen du client tenant
// (utilisé par défaut dans lib/prisma.ts → `import { prisma }`).
//
// Source de vérité pour les migrations DB : prisma/schema.prisma. Quand
// un modèle tenant change, mettre à jour les DEUX fichiers en parallèle.
// Les modèles admin (Client, Subscription, AuditLog) ne sont PAS dans ce
// fichier — ils restent dans prisma/schema.prisma + multiSchema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  /// Nullable depuis le chantier SSO : un compte fédéré (ssoProvider non null)
  /// n'a pas de mot de passe Physalis. Credentials refuse si password est null.
  password                 String?
  /// SSO — null pour un compte mot de passe classique ; "google"|"github"|…
  /// pour un compte fédéré (dénormalisé pour l'affichage UI sécurité).
  ssoProvider              String?
  role                     Role                      @default(MEMBER)
  /// 2FA TOTP — secret chiffré avec la même ENCRYPTION_KEY que les Secrets
  /// (3 colonnes : encryptedValue/iv/tag, base64). Désactivé par défaut.
  twoFactorEnabled         Boolean                   @default(false)
  twoFactorSecret          String?
  twoFactorIv              String?
  twoFactorTag             String?
  /// 8 codes de secours bcrypt-hashés. Vidé à chaque rotation 2FA.
  backupCodes              String[]                  @default([])
  /// §2.17 — dernier pas de temps TOTP consommé (RFC 6238 §5.2, anti-rejeu).
  /// Un code n'est accepté que si son timeStep > lastTotpTimeStep.
  lastTotpTimeStep         Int?
  projects                 ProjectMember[]
  organizations            OrgMember[]
  invitationsSent          Invitation[]              @relation("invitedBy")
  invitationsReceived      Invitation[]              @relation("invitationsReceived")
  createdMachineTokens     MachineToken[]            @relation("machineTokenCreator")
  pluginTokens             PluginToken[]
  vaultEntries             VaultEntry[]
  vaultCollections         VaultCollection[]
  teamVaultMemberships     TeamVaultMember[]
  userTokens               UserToken[]
  orgTokensCreated         OrgToken[]                @relation("orgTokenCreator")
  oneTimeShares            OneTimeShare[]            @relation("oneTimeShareCreator")
  accessLogs               AccessLog[]               @relation("accessLogActor")
  secretRequests           SecretRequest[]           @relation("secretRequestCreator")
  secretVersions           SecretVersion[]           @relation("secretVersionCreator")
  orgSecretVersions        OrgSecretVersion[]        @relation("orgSecretVersionCreator")
  mobileCredentialVersions MobileCredentialVersion[] @relation("mobileCredentialVersionCreator")
  apiKeysCreated           ApiKey[]                  @relation("apiKeyCreator")
  createdAt                DateTime                  @default(now())
  /// #5 — borne basse de validité des sessions : tout JWT émis avant cette
  /// date est rejeté par requireUser(). Posé au reset password / 2FA disable
  /// pour couper les sessions existantes. NULL = jamais invalidé (legacy).
  sessionsValidFrom        DateTime?
  /// Suppression de compte MEMBRE (self-service) — à ne pas confondre avec la
  /// suppression du compte CLIENT, qui vit sur `admin.clients`. Ici le tenant
  /// survit : seule cette ligne `User` et ses dépendances en Cascade (coffre
  /// perso, appartenances, tokens) disparaissent à `purgeAt`. C'est
  /// `deletionRequestedAt` — et non un statut — qui fait foi et déclenche le
  /// verrou d'espace. NULL hors processus.
  deletionRequestedAt      DateTime?
  purgeAt                  DateTime?
  /// Dernier export RGPD réussi (/api/me/export). Alimente le compteur
  /// « X membres sur Y ont récupéré leurs données » et la règle du plancher
  /// côté owner ; seul un export POSTÉRIEUR à la demande compte.
  dataExportedAt           DateTime?
  /// Identités externes liées (social login / SSO perso, Phase F).
  socialIdentities         UserSocialIdentity[]
}

/// Identité externe (social login / SSO perso) liée à un User. L'utilisateur lie
/// explicitement son compte Google/GitHub/Microsoft depuis /account/security
/// (via l'app OAuth de Physalis, pas celle du tenant) ; au login social on
/// retrouve le User par (provider, sub). PAS d'auto-provisioning. Voir
/// steps-docs/todo/sso.md (Phase F).
model UserSocialIdentity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Provider social : "google" | "github" | "microsoft".
  provider  String
  /// Subject id stable de l'IdP — clé de matching au login.
  sub       String
  /// Email au moment du lien (affichage/audit ; PAS la clé de match). Nullable :
  /// certains IdP (GitHub email masqué) ne le renvoient pas.
  email     String?
  createdAt DateTime @default(now())

  @@unique([provider, sub])
  @@unique([userId, provider])
  @@index([userId])
}

model PluginToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id                     String                @id @default(cuid())
  name                   String
  slug                   String                @unique
  members                OrgMember[]
  projects               Project[]
  projectGroups          ProjectGroup[]
  invitations            Invitation[]
  secrets                OrgSecret[]
  servers                Server[]
  ciConnections          CiConnection[]
  teamVaultCollections   TeamVaultCollection[]
  oneTimeShares          OneTimeShare[]
  accessLogs             AccessLog[]
  secretRequests         SecretRequest[]
  orgTokens              OrgToken[]
  rotationFeatureEnabled Boolean               @default(false)
  // ─── Cloisonnement orgs (refonte pricing) ──────────────────────────
  /// org principale = compte général du tenant. Ses quotas sont DÉRIVÉS
  /// du plan (PLAN_QUOTAS + client.extra*) ; les champs maxX ci-dessous
  /// sont ignorés pour la primaire. Les orgs ajoutées portent leur
  /// propre bundle isolé (ADDON_ORG_BUNDLE).
  isPrimary              Boolean               @default(false)
  /// Quotas isolés des orgs AJOUTÉES (defaults = ADDON_ORG_BUNDLE).
  maxServers             Int                   @default(2)
  maxOidcProjects        Int                   @default(10)
  /// Posé pour le futur — emails restent métrés au niveau client (non
  /// branché par org en Phase B).
  maxEmailsPerMonth      Int                   @default(1000)
  extraEmails            Int                   @default(0)
  /// Sièges propres à l'org (confinés, isolés du pool global du plan).
  maxSeats               Int                   @default(2)
  createdAt              DateTime              @default(now())
}

/// Configuration email Physalis Email au niveau CLIENT (tenant) — singleton par
/// schéma tenant. Le compte Physalis Email est créé avec `externalRef = tenantSlug`
/// (globalement unique, contrairement au slug d'org qui ne l'est qu'au sein du
/// tenant). `accountId` = compte partagé par TOUS les projets/orgs du client.
/// `enabled` : interrupteur explicite. `tenantSlug` sert de clé d'upsert.
model ClientEmailConfig {
  id         String   @id @default(cuid())
  tenantSlug String   @unique
  enabled    Boolean  @default(false)
  accountId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Interrupteur du service de backup automatisé au niveau CLIENT (tenant) —
/// singleton par schéma tenant, comme ClientEmailConfig. `enabled` = master
/// switch ; la config par projet (ProjectBackupConfig, cf. spec backups-auto.md)
/// viendra ensuite et exigera ce switch.
model ClientBackupConfig {
  id             String   @id @default(cuid())
  tenantSlug     String   @unique
  enabled        Boolean  @default(false)
  /// Destination des backups, au niveau CLIENT (un VPS pour tous ses projets).
  /// Le chemin effectif d'un projet est dérivé : backupPath/<slug projet>.
  backupServerId String?
  backupServer   Server?  @relation("BackupDest", fields: [backupServerId], references: [id])
  backupPath     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Config de backup automatisé d'un projet (cf. documentation/plans/done/backups-auto.md).
/// Physalis ne détient QUE la clé GPG publique (postée par l'agent) ; ni le mot
/// de passe DB ni la clé privée ne vivent ici. La destination est un Server.
model ProjectBackupConfig {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  enabled         Boolean @default(false)
  /// Un seul environnement backupé par projet (prod par défaut).
  environmentName String

  // DB(s) source : multi-DB → modèle enfant ProjectBackupDatabase.
  // La destination vit au niveau CLIENT (ClientBackupConfig).

  // GPG : Physalis ne tient que le public (posté par l'agent à l'enregistrement)
  gpgPublicKey      String?
  gpgKeyId          String?
  agentRegisteredAt DateTime?

  // Chiffrement par enveloppe + KMS (système ①, cf. backup-clients-kms-plan.md).
  // Dual-path : null/"gpg-rsa4096" = legacy GPG par-VPS ; "kms-envelope-v1" =
  // l'agent scelle via OpenBao transit (datakey) → archive .penv.
  // `kmsKeyName` = nom logique de la KEK transit du tenant (`tenant-<slug>`).
  // Physalis ne détient JAMAIS la KEK ni de capacité decrypt sur les données.
  backupKeyScheme  String?
  kmsKeyName       String?
  /// Hash SHA-256 du token d'agent — vérifie register/plan/report (timingSafeEqual,
  /// sans déchiffrer à chaque poll).
  agentTokenHash   String?
  /// Copie chiffrée (AES-256-GCM) du MÊME token, pour l'injection zéro-touch dans le
  /// bundle de déploiement (Physalis déchiffre et pose BACKUP_TOKEN). Même posture que
  /// la clé SSH du serveur, déjà dans le bundle. Null tant qu'aucun token n'a été émis.
  agentTokenEnc    String?
  agentTokenIv     String?
  agentTokenTag    String?
  /// Anti-spam du watchdog : dernière alerte « backup en retard » envoyée.
  overdueAlertedAt DateTime?

  // Rétention (appliquée côté agent)
  retentionDaily   Int @default(7)
  retentionWeekly  Int @default(4)
  retentionMonthly Int @default(3)

  // Planification (servie à l'agent ; le cron Physalis = watchdog)
  scheduleHour     Int       @default(3)
  intervalDays     Int       @default(1)
  backupNextAt     DateTime?
  backupLastAt     DateTime?
  backupLastStatus String?
  backupErrorCount Int       @default(0)
  forceRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  databases ProjectBackupDatabase[]
  entries   ProjectBackupEntry[]
  restores  ProjectBackupRestore[]
}

/// Une DB d'un projet à sauvegarder (un projet peut en avoir plusieurs).
/// Détectée depuis le docker-compose + .env, éditable par l'utilisateur.
/// Physalis ne stocke PAS le mot de passe : seulement la clé du secret (.env)
/// qui le contient, pour l'injecter au déploiement.
model ProjectBackupDatabase {
  id       String              @id @default(cuid())
  configId String
  config   ProjectBackupConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  dbType            BackupDbType
  dbName            String
  /// Hostname sur le réseau docker du projet (= nom du service db).
  dbHost            String
  dbUser            String
  /// Clé du secret (.env) contenant le mot de passe (null si en clair / non résolu).
  passwordSecretKey String?
  port              Int?
  enabled           Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([configId])
}

/// Une archive de backup (remplie par les rapports de l'agent — tranche suivante).
model ProjectBackupEntry {
  id        String              @id @default(cuid())
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configId  String
  config    ProjectBackupConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  filename        String
  sizeBytes       BigInt?
  dbType          BackupDbType
  dbName          String
  environmentName String
  destLocation    String

  status       BackupEntryStatus
  errorMessage String?
  restorable   Boolean           @default(true)
  restoreJobId String?
  createdAt    DateTime          @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status])
  @@index([configId])
}

/// Job de restauration orchestré (agent-driven, système ①, cf. backup-clients-kms-plan.md §4).
/// Le control plane crée la demande (PENDING) ; l'agent la poll, tire l'archive
/// `.penv` depuis la destination, déchiffre via OpenBao (identité restore = decrypt),
/// et restaure EN LOCAL sur le VPS. Physalis ne voit jamais le plaintext.
model ProjectBackupRestore {
  id        String              @id @default(cuid())
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configId  String
  config    ProjectBackupConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  filename        String
  destLocation    String
  dbType          BackupDbType
  dbName          String // DB source (= clé pour matcher la connexion côté agent)
  environmentName String
  targetDbName    String // DB cible (par défaut = dbName ; distincte pour une restauration sûre)
  /// true = remplacer en place (la cible peut être non vide ; le dump --clean
  /// drop+recreate). false = restaurer dans une DB neuve/vide (garde-fou agent).
  replaceExisting Boolean      @default(false)

  status        RestoreStatus @default(PENDING)
  errorMessage  String?
  requestedById String?
  claimedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([configId, status])
  @@index([projectId, createdAt(sort: Desc)])
}

enum RestoreStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum BackupDbType {
  POSTGRESQL
  MYSQL
  MARIADB
}

enum BackupEntryStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Configuration email Physalis Email au niveau projet : un domaine + une clé API
/// par projet, partagés par tous ses environnements (injectés dans le .env au
/// déploiement). La clé API est chiffrée au repos (même schéma AES-256-GCM que
/// Secret/Service). Les enregistrements DNS sont mémorisés en JSON.
model ProjectEmailConfig {
  id                   String    @id @default(cuid())
  projectId            String    @unique
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain               String
  domainId             String
  keyId                String
  encryptedKey         String
  iv                   String
  tag                  String
  verified             Boolean   @default(false)
  dnsRecords           Json      @default("[]")
  /// Expéditeur principal du projet, injecté en `PHYSALIS_EMAIL_FROM` au
  /// déploiement. On ne stocke que l'ADRESSE : le nom d'affichage vit côté
  /// relais (sur le sender) et y est appliqué à l'envoi, donc le renommer ne
  /// demande pas de redeploy. Le premier expéditeur créé le devient d'office ;
  /// supprimer l'expéditeur principal remet ce champ à null.
  defaultSender        String?
  /// Rotation automatique de la clé API (blue/green). À la rotation, on crée
  /// une nouvelle clé + redeploy, et on diffère la révocation de l'ancienne au
  /// cycle suivant (fenêtre de grâce — l'app lit la clé depuis son .env, mis à
  /// jour seulement au redeploy). `pendingRevokeKeyId` = ancienne clé à révoquer.
  rotationEnabled      Boolean   @default(false)
  rotationIntervalDays Int?
  rotationNextAt       DateTime?
  rotationLastAt       DateTime?
  rotationLastStatus   String?
  rotationErrorCount   Int       @default(0)
  pendingRevokeKeyId   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([rotationNextAt])
}

model Server {
  id             String               @id @default(cuid())
  name           String
  ip             String
  sshUser        String
  encryptedKey   String
  iv             String
  tag            String
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments   Environment[]
  backupDests    ClientBackupConfig[] @relation("BackupDest")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

enum DatabaseType {
  POSTGRESQL
  MYSQL
  MONGODB
}

model OrgSecret {
  id             String             @id @default(cuid())
  key            String
  encryptedValue String
  iv             String
  tag            String
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       OrgSecretVersion[]
  /// Rappel manuel de renouvellement (ex. expiration d'un PAT). Saisi à la création
  /// via une durée ; Physalis ne connaît pas l'expiration réelle d'un token GitHub.
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, key])
}

/// Historique des valeurs d'un OrgSecret (Phase 10 — versioning).
/// Cf. SecretVersion pour la spec complète. Mêmes contraintes :
/// rétention 50 versions, UNIQUE(orgSecretId, version) pour les races.
model OrgSecretVersion {
  id             String    @id @default(cuid())
  orgSecretId    String
  orgSecret      OrgSecret @relation(fields: [orgSecretId], references: [id], onDelete: Cascade)
  encryptedValue String
  iv             String
  tag            String
  version        Int
  createdById    String?
  createdBy      User?     @relation("orgSecretVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@unique([orgSecretId, version])
  @@index([orgSecretId, version(sort: Desc)])
}

model OrgMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole      @default(MEMBER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model Invitation {
  id             String    @id @default(cuid())
  email          String
  organizationId String
  role           OrgRole   @default(MEMBER)
  /// #2 — accès projet pré-attribués à l'invitation (appliqués à l'acceptation).
  /// Tableau JSON `[{ projectId, role }]`. Null = aucun accès projet pré-set.
  projectAccess  Json?
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  inviteeUserId  String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("invitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  inviteeUser  User?        @relation("invitationsReceived", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviteeUserId])
}

model Project {
  id                   String                 @id @default(cuid())
  name                 String
  slug                 String                 @unique
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members              ProjectMember[]
  environments         Environment[]
  tokens               MachineToken[]
  accessLogs           AccessLog[]
  services             Service[]
  appAccounts          AppAccount[]
  policies             Policy[]
  teamVaultCollections TeamVaultCollection[]
  secretRequests       SecretRequest[]
  apis                 Api[]
  emailConfig          ProjectEmailConfig?
  backupConfig         ProjectBackupConfig?
  backupEntries        ProjectBackupEntry[]
  backupRestores       ProjectBackupRestore[]
  docs                 ProjectDoc[]
  mobileApps           MobileApp[]
  /// Groupe d'organisation (kanban projets). Null = « Sans groupe ».
  groupId              String?
  group                ProjectGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Ordre du projet à l'intérieur de son groupe (ou des non-groupés). Posé
  /// explicitement par le drag-and-drop ; ties cassés par createdAt.
  position             Int                    @default(0)
  githubRepo           String?
  githubWorkflow       String?
  /// Connexion CI/CD org-level (provider + issuer + tokens). Cf. modèle public.
  ciConnectionId       String?
  ciConnection         CiConnection?          @relation(fields: [ciConnectionId], references: [id], onDelete: SetNull)
  /// Repo natif quand le provider ≠ github (group/project GitLab ou UUID Bitbucket).
  ciRepo               String?
  /// Dernier fetch des docs depuis le repo (null = jamais tenté). Distingue
  /// « aucun fichier de doc » de « jamais récupéré ».
  docsFetchedAt        DateTime?
  rotationPaused       Boolean                @default(false)
  /// Onglet « Mobile » activé pour CE projet — DÉFAUT OFF. Deux verrous
  /// distincts : la feature de plan `mobile_deploy` (payante, refusée en FREE)
  /// ouvre la capacité au tenant, ce drapeau la déclenche projet par projet
  /// depuis la modale Paramètres. Un projet sans publication mobile ne porte
  /// donc pas l'onglet.
  mobileEnabled        Boolean                @default(false)
  createdAt            DateTime               @default(now())

  @@index([organizationId])
  @@index([ciConnectionId])
  @@index([groupId])
}

/// Groupe de projets au niveau organisation (regroupement type kanban sur la
/// page Projets). L'ordre des groupes et des projets dedans est piloté par le
/// drag-and-drop. La suppression d'un groupe détache ses projets (SetNull).
model ProjectGroup {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]
  /// Ordre de la section groupe sur la page.
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// Connexion CI/CD au niveau organisation (cf. modèle public schema.prisma).
model CiConnection {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  provider       String                  @default("github")
  issuer         String?
  secrets        CiConnectionSecret[]
  projects       Project[]
  syncTargets    EnvironmentSyncTarget[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Secret chiffré d'une CiConnection, typé par `kind` (redeploy_token |
/// registry_url | registry_user | registry_token). Cf. modèle public.
model CiConnectionSecret {
  id             String       @id @default(cuid())
  connectionId   String
  connection     CiConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  kind           String
  encryptedValue String
  iv             String
  tag            String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([connectionId, kind])
}

/// Cible de synchronisation sortante d'un environnement (Vercel, puis
/// Render/Railway). Cf. modèle public + lib/sync/.
model EnvironmentSyncTarget {
  id                    String       @id @default(cuid())
  environmentId         String
  environment           Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  ciConnectionId        String
  ciConnection          CiConnection @relation(fields: [ciConnectionId], references: [id], onDelete: Cascade)
  externalProjectId     String
  externalProjectName   String?
  externalEnvironmentId String?
  externalServiceId     String?
  targets               String[]     @default([])
  tagFilter             String[]     @default([])
  lastSyncAt            DateTime?
  lastSyncStatus        String?
  lastSyncError         String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([environmentId, ciConnectionId])
  @@index([ciConnectionId])
  @@index([lastSyncStatus])
}

/// Doc projet récupérée depuis le repo GitHub (readme / technique / sécurité) et
/// mise en cache. Une ligne n'existe QUE si le fichier existait au dernier fetch
/// → l'absence de ligne = fichier absent. Cf. physalis.md.
model ProjectDoc {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      ProjectDocKind
  content   String // markdown brut
  fetchedAt DateTime       @default(now())

  @@unique([projectId, kind])
  @@index([projectId])
}

enum ProjectDocKind {
  README
  TECHNICAL
  SECURITY
}

model Policy {
  id            String       @id @default(cuid())
  /// "github" | "gitlab" | "bitbucket". String, pas enum PG.
  provider      String       @default("github")
  /// Issuer OIDC ; null = défaut du provider (github.com / gitlab.com).
  /// Rempli pour GitLab self-hosted et Bitbucket.
  issuer        String?
  repo          String
  /// github : fichier workflow ; gitlab/bitbucket : environment CI ("" = tout).
  workflow      String
  branch        String
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "server" (défaut) | "mobile" — cf. OidcPolicy.kind côté admin.
  kind          String       @default("server")
  /// Renseigné SSI kind = "server".
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  /// Renseigné SSI kind = "mobile".
  mobileAppId   String?
  mobileApp     MobileApp?   @relation(fields: [mobileAppId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  /// Deux uniques : cf. la note du modèle OidcPolicy — un UNIQUE ne dédoublonne
  /// pas les lignes dont une colonne est NULL.
  @@unique([provider, repo, workflow, branch, projectId, environmentId], map: "Policy_provider_repo_wf_branch_proj_env_key")
  @@unique([provider, repo, workflow, branch, projectId, mobileAppId], map: "Policy_provider_repo_wf_branch_proj_mobile_key")
  @@index([provider, repo, workflow, branch])
  @@index([projectId])
  @@index([environmentId])
  @@index([mobileAppId])
}

model Service {
  id            String   @id @default(cuid())
  name          String
  url           String?
  encryptedData String
  iv            String
  tag           String
  /// Tags techniques pour le filtrage dans les intégrations (N8n/Make).
  /// Distinct de `Secret.category` (organisation visuelle UI). Ex: ["stripe", "production"].
  tags          String[] @default([])
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Comptes applicatifs dont l'URL pointe vers ce service (backend).
  appAccounts AppAccount[]

  // Rotation REMINDER (Phase B) — rappel d'âge + rotation assistée des creds DU
  // service (Stripe-like). Pas de versioning → historique capé à 3.
  rotationEnabled      Boolean   @default(false)
  rotationIntervalDays Int?
  rotationLastAt       DateTime?
  rotationNextAt       DateTime?
  rotationLastStatus   String?
  rotationHistory      Json?

  // Hook de rotation des COMPTES liés (Phase C) — service "backend". Les comptes
  // en stratégie WEBHOOK liés à ce service rotent via ce hook. Optionnel (un
  // service Stripe-like n'en a pas). rotationExecMode : "AGENT" | "DIRECT".
  rotationWebhookUrl String?
  rotationHookToken  String?
  rotationExecMode   String?

  // Cible de rotation DATABASE des COMPTES liés (A3) — service "base de données
  // managée" (Supabase/RDS/Neon…). La connexion (host/port/base) vit ici, AINSI
  // QUE des identifiants admin DB DÉDIÉS (dbUser + mot de passe chiffré
  // dbPw*), DISTINCTS des creds « interface/dashboard » du service
  // (encryptedData {user,password}). Un compte lié en stratégie DATABASE rote
  // via cette connexion admin. dbType en TEXT (pas l'enum : absent du schéma public).
  dbType        String?
  dbHost        String?
  dbPort        Int?
  dbName        String?
  /// Identifiant admin de connexion DB (ex. `postgres` ou `postgres.<ref>` via
  /// pooler Supabase). Plaintext comme dbHost (le secret = le mot de passe).
  dbUser        String?
  /// Mot de passe admin DB, chiffré (AES-GCM, comme les autres secrets).
  dbPwEncrypted String?
  dbPwIv        String?
  dbPwTag       String?

  @@index([projectId])
  @@index([rotationNextAt])
}

model AppAccount {
  id            String   @id @default(cuid())
  name          String
  encryptedData String
  iv            String
  tag           String
  /// Tags techniques pour le filtrage dans les intégrations (N8n/Make).
  tags          String[] @default([])
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// URL/contexte du compte : lié à UN environnement (frontend) OU UN service
  /// (backend) — XOR au niveau app. L'URL affichée vient du lien. SetNull si la
  /// cible est supprimée (le compte survit, sans URL).
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  serviceId     String?
  service       Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // Rotation (Phase B REMINDER + Phase C WEBHOOK). Historique capé à 3.
  rotationEnabled      Boolean   @default(false)
  rotationIntervalDays Int?
  rotationLastAt       DateTime?
  rotationNextAt       DateTime?
  rotationLastStatus   String?
  rotationHistory      Json?
  /// Stratégie de rotation du compte : null/"REMINDER" (rappel manuel assisté,
  /// défaut), "WEBHOOK" (hook côté app) ou "DATABASE" (rôle/utilisateur d'une DB
  /// managée via la connexion admin du service lié).
  rotationStrategy     String?
  /// WEBHOOK : "AGENT" (hook interne réseau Docker, l'agent appelle) ou "DIRECT"
  /// (hook joignable depuis Physalis). rotationWebhookUrl + token Bearer optionnel.
  rotationExecMode     String?
  rotationWebhookUrl   String?
  rotationHookToken    String?
  /// DATABASE : type de cible — null/"role" (rôle PostgreSQL → ALTER ROLE,
  /// défaut) ou "supabase_auth" (utilisateur Supabase Auth → UPDATE auth.users,
  /// le `user` du compte = l'email). Le SQL exécuté par l'admin du service.
  rotationDbTarget     String?

  @@index([projectId])
  @@index([rotationNextAt])
  @@index([environmentId])
  @@index([serviceId])
}

model Environment {
  id            String                  @id @default(cuid())
  name          String
  projectId     String
  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url           String?
  dockerCompose String?
  serverId      String?
  server        Server?                 @relation(fields: [serverId], references: [id], onDelete: SetNull)
  deployPath    String?
  secrets       Secret[]
  tokens        MachineToken[]
  policies      Policy[]
  liveApis      Api[]                   @relation("apiLiveEnv")
  testApis      Api[]                   @relation("apiTestEnv")
  syncTargets   EnvironmentSyncTarget[]
  /// Comptes applicatifs dont l'URL pointe vers cet environnement (frontend).
  appAccounts   AppAccount[]

  @@unique([projectId, name])
  @@index([serverId])
}

model Secret {
  id                       String            @id @default(cuid())
  key                      String
  encryptedValue           String
  iv                       String
  tag                      String
  category                 String?
  /// Tags techniques pour le filtrage dans les intégrations (N8n/Make).
  /// Distinct de `category` (organisation visuelle UI). Ex: ["postgres", "production"].
  tags                     String[]          @default([])
  environmentId            String
  environment              Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  versions                 SecretVersion[]
  rotationEnabled          Boolean           @default(false)
  rotationStrategy         RotationStrategy?
  rotationIntervalDays     Int?
  rotationLastAt           DateTime?
  rotationNextAt           DateTime?
  rotationLastStatus       String? // "success" | "error" | null
  rotationErrorCount       Int               @default(0)
  /// Mode d'exécution de la rotation DATABASE : "AGENT" (DB Docker-interne, sidecar
  /// agent self-rotation) ou "DIRECT" (DB managée joignable, chemin N8n). Défaut AGENT.
  rotationExecMode         String            @default("AGENT")
  /// Demande de rotation immédiate (bouton « Forcer ») : bypass la fenêtre horaire
  /// planifiée. Posé par /rotation/force (mode AGENT), purgé au report. null = pas de force.
  rotationForceRequestedAt DateTime?
  dbHost                   String?
  dbPort                   Int?
  dbName                   String?
  dbType                   DatabaseType?
  dbUser                   String?
  rotationNeedsFullDeploy  Boolean           @default(false)
  rotationWebhookUrl       String?
  /// Stratégie WEBHOOK (Phase C) — libellé de la cible (ex. « Compte admin de l'app »)
  /// pour lever le flou UX, et token Bearer optionnel envoyé au hook pour l'auth.
  rotationHookLabel        String?
  rotationHookToken        String?
  jwtRedeployWebhookUrl    String?
  apiKeyId                 String?
  apiKey                   ApiKey?           @relation("secretApiKey", fields: [apiKeyId], references: [id], onDelete: SetNull)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@unique([environmentId, key])
  @@index([rotationNextAt])
}

enum RotationStrategy {
  DATABASE
  JWT_SECRET
  WEBHOOK
  REMINDER
  API_KEY
}

/// Historique des valeurs d'un Secret (Phase 10 — versioning).
/// Chaque row = un snapshot de l'ancienne valeur juste avant un update.
/// Rétention : 50 versions max par secret (cleanup au INSERT côté code).
/// UNIQUE(secretId, version) pour gérer les race conditions sur
/// MAX(version)+1 — retry côté code en cas de conflit.
model SecretVersion {
  id             String   @id @default(cuid())
  secretId       String
  secret         Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  encryptedValue String
  iv             String
  tag            String
  version        Int
  createdById    String?
  createdBy      User?    @relation("secretVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@unique([secretId, version])
  @@index([secretId, version(sort: Desc)])
}

/// Une application publiable = un couple (projet, plateforme, identifiant magasin).
/// Cf. documentation/plans/deploiement-mobile.md §4.2. Phase 1 (socle credentials).
/// Volontairement absent de prisma/schema.prisma (comme ProjectBackupConfig) :
/// tenant-only, aucun consommateur admin-side à ce stade. La migration crée la
/// table via un DO block hand-écrit (motif SecretRequest), pas via un diff
/// `prisma migrate dev` sur schema.prisma.
model MobileApp {
  id           String             @id @default(cuid())
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "android" | "ios". String, pas enum PG (cf. Policy.provider — un ALTER
  /// TYPE sur un enum tenant-only plante le déploiement admin, mémoire
  /// orgrole-enum-tenant-only).
  platform     String
  /// applicationId Android (com.exemple.app) ou bundleId iOS.
  bundleId     String
  displayName  String
  /// Team ID Apple / identifiant développeur Play. Informatif + préremplissage.
  vendorTeamId String?
  /// Étiquette de regroupement cosmétique ("Production"/"Staging"/"Dev"),
  /// orthogonale à `platform` — décidé §10.5 du plan (2026-08-14). Purement
  /// UI, non contrainte : le repliage visuel par groupe est différé.
  group        String?
  /// Version marketing servie au CI (CFBundleShortVersionString / versionName),
  /// ex. "1.4". Fixée à la main : bumper une version est une décision humaine.
  versionName  String?
  /// Dernier numéro de build SERVI (CFBundleVersion / versionCode). À
  /// initialiser au dernier numéro déjà publié sur le store ; chaque
  /// POST /api/deploy/mobile sert `buildNumber + 1` et le persiste. Compteur
  /// LOCAL (repli §4.5 du plan) : la lecture autoritative du magasin est la
  /// Phase 5. Des trous après un échec de build sont sans conséquence (un
  /// numéro de build doit croître, pas être contigu).
  buildNumber  Int                @default(0)
  /// Coupe-circuit de publication PAR APP (donc par plateforme). true =>
  /// /api/deploy/mobile répond 403 « publications en pause » à un pipeline
  /// pourtant autorisé — gel manuel depuis la console, audité, sans toucher au
  /// CI. Même motif que Secret.rotationPaused / Project.rotationPaused. La
  /// FRONTIÈRE (policy) reste intacte : c'est un veto ponctuel, pas une
  /// révocation d'accès.
  deployPaused Boolean            @default(false)
  credentials  MobileCredential[]
  releases     MobileRelease[]
  policies     Policy[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([projectId, platform, bundleId])
  @@index([projectId])
}

/// Matériel de signature et accès magasin (keystore, certificat, clé d'API…).
/// La valeur est TOUJOURS du base64 (même un champ texte comme un mot de
/// passe) : un seul chemin de codage. Séparé de `Secret` à dessein — un
/// `Secret` coule dans le `.env` du bundle serveur, un keystore base64 y
/// serait une fuite gratuite (plan §4.2).
model MobileCredential {
  id              String                    @id @default(cuid())
  appId           String
  app             MobileApp                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// "android_keystore" | "android_keystore_password" | "android_key_alias" |
  /// "android_key_password" | "play_service_account" | "ios_p12" |
  /// "ios_p12_password" | "ios_profile" | "asc_api_key" | "asc_key_id" |
  /// "asc_issuer_id" — cf. plan §4.4. String, pas enum PG (même motif).
  kind            String
  /// Nom de fichier d'origine (restitué au CI ; sert aussi à l'UI).
  filename        String?
  sizeBytes       Int
  /// Empreinte SHA-256 du CLAIR — détecte un remplacement et corrèle un
  /// bundle à ce qui a réellement signé, sans révéler la valeur.
  sha256          String
  encryptedValue  String
  iv              String
  tag             String
  /// Extraite du matériel à l'import (certificat X.509, profil provisioning).
  /// Null si le type n'a pas de notion d'expiration (mot de passe, clé .p8).
  expiresAt       DateTime?
  /// Dernier rappel d'expiration envoyé — anti-spam, motif
  /// ProjectBackupConfig.overdueAlertedAt. Phase 4 (pas encore émis en Phase 1).
  expiryAlertedAt DateTime?
  versions        MobileCredentialVersion[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([appId, kind])
  @@index([expiresAt])
}

/// Une livraison. Physalis ne détient PAS l'artefact (§3.2) — seulement son
/// signalement : quelle version est partie sur quelle piste, signée par quel
/// matériel, poussée par quel pipeline. C'est la réponse en un écran à une
/// question qui vit aujourd'hui dans trois consoles et un canal Slack (§5.3).
model MobileRelease {
  id             String    @id @default(cuid())
  appId          String
  app            MobileApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// "internal" | "alpha" | "beta" | "production" (Play) ;
  /// "testflight" | "appstore" (iOS).
  ///
  /// ⚠️ Écart au plan, assumé : la ligne naît AU MOMENT OÙ LE BUNDLE EST SERVI,
  /// donc avant que la piste soit connue — le CI ne la décide qu'à l'upload.
  /// Elle vaut donc "pending" jusqu'au /report. Créer la ligne plus tôt est ce
  /// qui rend la corrélation matériel↔version VRAIE : elle est écrite par
  /// Physalis à partir de ce qu'il a réellement servi, pas déclarée après coup
  /// par le pipeline.
  track          String    @default("pending")
  /// versionName / CFBundleShortVersionString.
  versionName    String?
  /// versionCode / CFBundleVersion. Texte et non entier : iOS accepte "1.2.3".
  buildNumber    String
  /// "reported" (le CI l'a dit) | "store" (relu au magasin, Phase 5).
  statusSource   String    @default("reported")
  /// requested | uploaded | processing | in_review | live | halted | rejected | failed
  status         String    @default("requested")
  statusDetail   String?
  /// Empreintes du matériel SERVI, par kind : { "ios_p12": "AB12…" }. Répond à
  /// « quel certificat a signé cette version » sans révéler la moindre valeur —
  /// et permet de repérer qu'un build est parti sous un certificat depuis
  /// remplacé.
  credentialsSha Json      @default("{}")
  /// Identité du pipeline (claims OIDC déjà vérifiés) — « qui a publié ça ».
  ciProvider     String?
  ciRepo         String?
  ciRef          String?
  requestedAt    DateTime  @default(now())
  reportedAt     DateTime?
  storeSyncedAt  DateTime?

  @@unique([appId, track, buildNumber])
  @@index([appId, requestedAt(sort: Desc)])
  @@index([status])
}

/// Calque de SecretVersion : snapshot avant remplacement, même colonnes,
/// même @@unique, même limite de rétention (cf. lib/versioning.ts).
model MobileCredentialVersion {
  id             String           @id @default(cuid())
  credentialId   String
  credential     MobileCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  encryptedValue String
  iv             String
  tag            String
  version        Int
  createdById    String?
  createdBy      User?            @relation("mobileCredentialVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@unique([credentialId, version])
  @@index([credentialId, version(sort: Desc)])
}

model MachineToken {
  id            String      @id @default(cuid())
  name          String
  tokenHash     String      @unique
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdById   String?
  createdBy     User?       @relation("machineTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())
  revokedAt     DateTime?
}

/// UserToken (Phase 11a) — token Bearer scopé à un User (vs MachineToken
/// scopé project+env). Donne accès READ aux projets dont l'user est
/// ProjectMember, à son rôle effectif (VIEWER+). Cas d'usage : workflow
/// N8n / Make / scripts qui touchent plusieurs projets sous le même
/// compte. Préfixe brut `sv_user_<32 hex>` distinguable de `sv_<hex>`.
model UserToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Libellé libre choisi par l'user, ex: "N8n Voyages workflows".
  name       String
  /// SHA-256 du token brut. UNIQUE pour le lookup au runtime.
  tokenHash  String    @unique
  /// 12 premiers chars du token (`sv_user_xxxx`) — affichage UI sans
  /// exposer le secret après la création.
  prefix     String
  /// Optionnel — null = jamais.
  expiresAt  DateTime?
  lastUsedAt DateTime?
  /// Révocation soft (revokedAt = now()) — évite le hard DELETE pour
  /// préserver les liens `INTEGRATION_*_FETCH` dans les AccessLog.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// OrgToken (Phase 11c) — token Bearer scopé à une Organization. Survit
/// au départ du user créateur (createdById SetNull, pas Cascade) — c'est
/// le différenciateur principal vs UserToken. Cas d'usage : workflows
/// N8n / Make institutionnels pérennes.
///
/// Permissions explicites :
///   - allowedScopes : enum OrgTokenScope (READ uniquement en V1)
///   - allowedProjectIds : tableau d'IDs de projets autorisés
///   - allProjects : boolean — true ouvre l'accès à tous les projets
///                   actuels et FUTURS de l'org
///
/// Sémantique :
///   - allProjects=false ET allowedProjectIds=[]   → AUCUN accès (état
///     invalide, à éviter via UI qui force la sélection)
///   - allProjects=false ET allowedProjectIds=[..] → seulement ces projets
///   - allProjects=true                            → tous les projets
///                                                   (allowedProjectIds ignoré)
///
/// Préfixe brut : `sv_org_<32 hex>`. OrgSecrets (lus via le panel
/// `/orgs/[slug]/secrets`) ne sont JAMAIS accessibles via OrgToken par
/// design — pas de scope dédié.
model OrgToken {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  tokenHash         String          @unique
  /// 12 premiers chars du token (`sv_org_xxxx`) pour affichage UI.
  prefix            String
  /// true → accès à tous les projets actuels ET FUTURS de l'org.
  /// Marker explicite (vs tableau vide ambigu) — vide = aucun accès.
  allProjects       Boolean         @default(false)
  allowedProjectIds String[]        @default([])
  allowedScopes     OrgTokenScope[] @default([])
  expiresAt         DateTime?
  lastUsedAt        DateTime?
  revokedAt         DateTime?
  /// SetNull au DELETE user → le token survit (différenciateur vs UserToken).
  createdById       String?
  createdBy         User?           @relation("orgTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())

  @@index([organizationId])
  @@index([expiresAt])
}

enum OrgTokenScope {
  SECRETS_READ
  SERVICES_READ
  ACCOUNTS_READ
  PROJECTS_LIST
}

model ProjectMember {
  id        String      @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole @default(VIEWER)
  hidden    Boolean     @default(false)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

enum Role {
  ADMIN
  MEMBER
  SUPERADMIN
}

enum OrgRole {
  OWNER
  ADMIN
  ADMIN_DEV
  DEV
  MEMBER
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

model VaultEntry {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Collection perso optionnelle (V2.0). NULL = "Sans catégorie".
  /// SetNull on delete : supprimer une collection ne supprime pas ses entrées.
  collectionId        String?
  collection          VaultCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  /// Forme de l'entrée : LOGIN | SECRET | LIST | NOTE (cf.
  /// lib/vault-entry-types.ts). TEXTE et pas enum PG : un enum tenant-only
  /// absent de `public` casse le deploy admin, et une 5ᵉ forme demanderait
  /// un ALTER TYPE … ADD VALUE avec le même piège.
  type                String           @default("LOGIN")
  name                String
  url                 String?
  username            String?
  encryptedPassword   String?
  passwordIv          String?
  passwordTag         String?
  encryptedTotpSecret String?
  totpSecretIv        String?
  totpSecretTag       String?
  /// Score de force du mot de passe (0-4, heuristique à la zxcvbn), calculé
  /// côté serveur au save. NULL = pas de mot de passe. Renseigné pour le
  /// seul type LOGIN — le scorer sur une clé d'API polluerait le filtre
  /// « mots de passe faibles ».
  passwordStrength    Int?
  /// Charge utile chiffrée des types LIST et NOTE (JSON AES-256-GCM :
  /// {items:[{label,value}]} ou {text}). Libellés compris — ils en disent
  /// plus long qu'une URL. NULL pour LOGIN et SECRET, qui n'utilisent que
  /// les colonnes ci-dessus.
  encryptedData       String?
  dataIv              String?
  dataTag             String?
  /// Nombre d'items d'une LIST, EN CLAIR : permet d'afficher « N secrets »
  /// dans la liste sans déchiffrer. NULL hors LIST.
  itemCount           Int?
  tags                String[]         @default([])
  favorite            Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([userId])
  @@index([collectionId])
}

/// Collection perso d'un User (V2.0 — coffre personnel).
/// Mirror simplifié de TeamVaultCollection : pas de members, scope user
/// strict (un user n'accède qu'à SES collections). Déclenchant `slug`
/// unique par user pour permettre des URLs propres + import idempotent.
model VaultCollection {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  entries   VaultEntry[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, slug])
  @@index([userId])
}

model TeamVaultCollection {
  id             String            @id @default(cuid())
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  entries        TeamVaultEntry[]
  members        TeamVaultMember[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, slug])
  @@unique([projectId, slug])
  @@index([organizationId])
  @@index([projectId])
}

model TeamVaultEntry {
