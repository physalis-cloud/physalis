/// Demande de secret externe (Phase 9). Un user DEV+ crée la demande,
/// reçoit un lien `<vault>/request/<token>` à transmettre au tiers
/// (qui n'a pas de compte Physalis). Le tiers chiffre son secret côté
/// navigateur via ECDH P-256 + AES-GCM puis le poste — Physalis stocke
/// le ciphertext sans pouvoir le déchiffrer (sauf si l'admin sauvegarde
/// sa clé privée dans son coffre, qui est lui-même chiffré au repos).
///
/// Lien one-shot : invalidé après soumission OU 48h.
model SecretRequest {
  id                 String       @id @default(cuid())
  /// SHA-256 du token brut (`sv_extreq_<32hex>`). Le brut n'est jamais stocké.
  tokenHash          String       @unique
  /// Label visible par le destinataire (ex: "Clé API Stripe production").
  label              String
  /// Description optionnelle, visible par le destinataire.
  description        String?
  /// Auteur de la demande (FK SetNull pour conserver la trace).
  requestedById      String?
  requestedBy        User?        @relation("secretRequestCreator", fields: [requestedById], references: [id], onDelete: SetNull)
  /// Email auteur dénormalisé (subsiste après suppression de l'user).
  requestedByEmail   String
  /// Email destinataire optionnel — si rempli, envoi auto via Mailgun.
  recipientEmail     String?
  /// Org propriétaire de la demande (Cascade : delete org → delete requests).
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Cible projet optionnelle (SetNull pour garder la trace même après
  /// suppression du projet — l'import devient impossible mais l'audit reste).
  projectId          String?
  project            Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Nom de l'environnement cible (string, pas FK — l'env peut être renommé).
  environmentName    String?
  /// Clé .env cible (ex: "STRIPE_SECRET_KEY"). Validée à l'import contre /^[A-Z][A-Z0-9_]*$/.
  secretKey          String?
  /// Clé publique ECDH P-256 sérialisée JWK. Stockée à la création,
  /// jamais sensible (publique par essence).
  publicKeyJwk       String
  /// Clé publique ML-KEM-768 (base64), volet post-quantique de l'échange
  /// hybride. NULL pour les demandes legacy (ECDH seul). Publique par essence.
  mlkemPublicKey     String?
  /// Ciphertext base64 (AES-GCM). Vide tant que non soumis. Effacé après import/revoke.
  encryptedSecret    String?
  /// IV AES-GCM base64. Idem.
  secretIv           String?
  /// Clé publique éphémère du client (JWK). Idem — le serveur en a besoin
  /// pour donner à l'admin de quoi dériver la clé symétrique au moment du reveal.
  ephemeralPublicKey String?
  /// Ciphertext ML-KEM-768 (base64) produit par le tiers à la soumission.
  /// NULL pour les demandes legacy (ECDH seul).
  mlkemCiphertext    String?
  /// Version du format hybride : 1 = ECDH+ML-KEM, NULL = legacy ECDH seul.
  hybridVersion      Int?
  submittedAt        DateTime?
  /// IP du soumetteur (audit, abuse-tracking).
  submitterIp        String?
  /// TTL strict 48h depuis createdAt.
  expiresAt          DateTime
  viewedAt           DateTime?
  importedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime     @default(now())

  @@index([organizationId])
  @@index([projectId])
  @@index([expiresAt])
}

// ─── API Gateway ─────────────────────────────────────────────────────

enum ApiValidationMode {
  REMOTE
  JWT
}

model Api {
  id                     String            @id @default(cuid())
  projectId              String
  project                Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  url                    String?
  mode                   ApiValidationMode @default(REMOTE)
  jwtSecret              String?
  jwtSecretIv            String?
  jwtSecretTag           String?
  defaultRateLimit       Int?
  defaultRateLimitWindow String            @default("1m")
  defaultExpiresIn       Int?
  liveEnvId              String?
  liveEnv                Environment?      @relation("apiLiveEnv", fields: [liveEnvId], references: [id], onDelete: SetNull)
  testEnvId              String?
  testEnv                Environment?      @relation("apiTestEnv", fields: [testEnvId], references: [id], onDelete: SetNull)
  keys                   ApiKey[]
  logs                   ApiLog[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model ApiKey {
  id              String    @id @default(cuid())
  apiId           String
  api             Api       @relation(fields: [apiId], references: [id], onDelete: Cascade)
  keyHash         String    @unique
  keyPrefix       String
  name            String
  description     String?
  scopes          String[]
  rateLimit       Int?
  rateLimitWindow String?
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdById     String?
  createdBy       User?     @relation("apiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  meta            Json?
  createdAt       DateTime  @default(now())
  secrets         Secret[]  @relation("secretApiKey")

  @@index([apiId])
}

model ApiLog {
  id         String   @id @default(cuid())
  apiId      String
  api        Api      @relation(fields: [apiId], references: [id], onDelete: Cascade)
  keyId      String?
  keyPrefix  String?
  method     String
  path       String?
  ipAddress  String?
  userAgent  String?
  valid      Boolean
  reason     String?
  statusCode Int?
  latencyMs  Int?
  createdAt  DateTime @default(now())

  @@index([apiId, createdAt(sort: Desc)])
  @@index([keyId, createdAt(sort: Desc)])
}

// ─── Notifications (chantier C-0048, T-0264 socle + T-0268 destinations) ────
//
// Ce que Physalis sait et dit à qui de droit. Stocké en CLÉ + VARIABLES, traduit
// à l'affichage / à l'envoi : `User` n'a pas de locale, une phrase figée naîtrait
// dans la langue du cron et y resterait.
//
// ⚠️ JAMAIS la valeur d'un secret, dans aucun champ (vars comprises).
// ⚠️ `type`, `channel`, `status`, `webhookFormat` sont du TEXTE, pas des enums :
//    un enum tenant-only absent de `public` casse le deploy admin.

/// Une notification d'organisation. `dedupKey` est le registre anti-répétition :
/// un même événement (même dedupKey) n'est écrit — donc envoyé — qu'une fois.
model Notification {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Projet concerné. SetNull : la notification survit à la suppression du
  /// projet, lisible grâce à `subjectName` (précédent : SecretRequest).
  projectId      String?
  project        Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Collection du coffre concernée (entrée de coffre d'équipe). Sert la
  /// VISIBILITÉ : une entrée de coffre d'org n'a pas de projet, seule l'accès
  /// à sa collection dit qui peut la voir (T-0265). SetNull : la notification
  /// survit, alors visible des seuls admins d'org.
  collectionId   String?
  collection     TeamVaultCollection?   @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  /// backup.failed | backup.recovered | backup.overdue | rotation.preavis |
  /// rotation.anciennete | test
  type           String
  /// Objet visé (ex. "ProjectBackupConfig" + id), sans FK : il peut disparaître.
  subjectKind    String?
  subjectId      String?
  /// Nom dénormalisé de l'objet (ex. nom du projet) — survit à sa suppression.
  subjectName    String
  /// Clé de traduction (namespace emails.notifications.*) + ses variables.
  messageKey     String
  vars           Json                   @default("{}")
  dedupKey       String?
  createdAt      DateTime               @default(now())
  reads          NotificationRead[]
  deliveries     NotificationDelivery[]

  @@unique([organizationId, dedupKey])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([projectId])
  @@index([collectionId])
  @@index([organizationId, type, subjectKind, subjectId, createdAt])
}

/// Lu/non-lu PAR PERSONNE : une notification d'organisation est vue par
/// plusieurs admins, le premier qui la lit ne doit pas l'éteindre pour les
/// autres. Forme tranchée par T-0264 ; lue par l'onglet (T-0266, à venir).
model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}

/// Registre des envois : une ligne par canal et par destinataire.
/// `target` = adresse email, ou `webhook:<entryId>` — JAMAIS l'URL (c'est un secret).
model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  /// email | webhook
  channel        String
  target         String
  /// sent | failed
  status         String
  /// Cause tronquée, sans URL.
  error          String?
  createdAt      DateTime     @default(now())

  @@index([notificationId])
}

/// Où partent les alertes : réglage d'ORGANISATION (scopeKey "org") et
/// surcharge PAR PROJET (scopeKey "project:<id>"), qui REMPLACE entièrement le
/// réglage d'org. Aucune ligne = défaut historique (OWNER seulement).
/// `scopeKey` porte l'unicité : un @@unique sur `projectId` nullable laisserait
/// passer plusieurs lignes d'org (NULL ≠ NULL en SQL).
model NotificationDestination {
  id                 String          @id @default(cuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId          String?
  project            Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scopeKey           String
  /// Prévenir les OWNER de l'org (+ ceux du projet, hors `hidden`).
  includeOwners      Boolean         @default(true)
  /// Adresses libres, y compris hors membres Physalis (≤ 20).
  emails             String[]        @default([])
  /// Webhook Slack/Discord/Teams : l'URL est un SECRET, rangée dans le coffre
  /// d'équipe et lue à l'envoi. SetNull si l'entrée est supprimée.
  webhookEntryId     String?
  webhookEntry       TeamVaultEntry? @relation(fields: [webhookEntryId], references: [id], onDelete: SetNull)
  /// Entrée de type LIST : LIBELLÉ de l'élément qui porte l'URL (jamais sa
  /// valeur). Null pour une entrée LOGIN / SECRET (valeur = champ secret).
  webhookItemLabel   String?
  /// slack | discord | teams
  webhookFormat      String?
  /// L'échec du canal se lit dans l'écran de configuration, jamais dans le
  /// canal lui-même (T-0268 ④).
  webhookLastOkAt    DateTime?
  webhookLastErrorAt DateTime?
  webhookLastError   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([organizationId, scopeKey])
  @@index([projectId])
  @@index([webhookEntryId])
}

// ─────────────────────────────────────────────────────────────────────────
// Modèles admin fusionnés en mono-DB pour le self-host.
//
// Dans secretvault (multi-tenant) ces modèles vivent dans le schéma `admin`
// (prisma/schema.prisma, denylisté). En self-host, base unique → on les
// append au schéma principal après le rename tenant-schema → schema.prisma.
// Append réalisé par build-public.mjs (cf. SCHEMA_APPEND_FILE).
//
// NB : `model Policy` n'est PAS ici — le tenant-schema le contient déjà
// (avec ses back-relations Project/Environment).
// ─────────────────────────────────────────────────────────────────────────

enum TokenKind {
  MACHINE
  PLUGIN
  SHARE
  SECRET_REQUEST
  USER
  ORG
  CLI
}

model TokenIndex {
  tokenHash  String    @id @map("token_hash")
  tenantSlug String    @map("tenant_slug") @db.VarChar(100)
  kind       TokenKind
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([tenantSlug, kind])
}

model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  tenantSlug String?   @map("tenant_slug") @db.VarChar(100)
  userId     String    @map("user_id")
  email      String    @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
}

// OidcPolicy — allowlist/index OIDC des déploiements (issuer, branche par
// (repo, workflow, branch, projet, env)). En SaaS c'est un index GLOBAL dans
// admin.policies (résolu par /api/deploy avant de connaître le tenant) ; en
// mono-tenant on le garde tel quel (table "policies") — redeploy.ts et
// policies/route.ts le lisent/écrivent verbatim via adminPrisma(=prisma).
// tenantSlug conservé pour matcher les requêtes du code (valeur unique en
// self-host). Pas de collision : le Policy tenant mappe la table "Policy".
model OidcPolicy {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider      String   @default("github")
  issuer        String?
  repo          String
  workflow      String
  branch        String
  tenantSlug    String   @map("tenant_slug") @db.VarChar(100)
  projectId     String   @map("project_id")
  /// "server" (défaut) | "mobile" — miroir du modèle SaaS, cf.
  /// prisma/schema.prisma OidcPolicy et deploiement-mobile.md §4.3.
  kind          String   @default("server")
  environmentId String?  @map("environment_id")
  mobileAppId   String?  @map("mobile_app_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  /// `map` explicite : les deux noms auto-générés se tronquent sur le même
  /// préfixe (63 caractères) et entrent en collision.
  @@unique([provider, repo, workflow, branch, tenantSlug, projectId, environmentId], map: "policies_provider_repo_wf_branch_tenant_proj_env_key")
  @@unique([provider, repo, workflow, branch, tenantSlug, projectId, mobileAppId], map: "policies_provider_repo_wf_branch_tenant_proj_mobile_key")
  @@index([provider, repo, workflow, branch])
  @@index([tenantSlug, projectId])
  @@index([issuer])
  @@map("policies")
}
